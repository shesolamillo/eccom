{# Quick Cart Preview Dropdown #}
<style>
    :root {
        --pink: #e91e8c;
        --pink-dark: #c0166f;
        --pink-light: #fce4f3;
        --pink-soft: #fdf5fb;
    }

    /* CART BUTTON */
    .cart-trigger-btn {
        width: 44px; height: 44px; border-radius: 50%;
        background: #fff; border: 1.5px solid #eaecf0;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: all 0.18s;
        position: relative;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .cart-trigger-btn:hover {
        border-color: var(--pink);
        background: var(--pink-soft);
        box-shadow: 0 4px 14px rgba(233,30,140,0.2);
    }
    .cart-trigger-btn i { font-size: 1.2rem; color: #374151; transition: color 0.15s; }
    .cart-trigger-btn:hover i { color: var(--pink); }

    #cartBadge {
        position: absolute; top: -4px; right: -4px;
        background: var(--pink); color: #fff;
        font-size: 0.6rem; font-weight: 800;
        width: 18px; height: 18px; border-radius: 50%;
        display: none; align-items: center; justify-content: center;
        border: 2px solid #fff;
        box-shadow: 0 2px 6px rgba(233,30,140,0.4);
    }

    /* DROPDOWN */
    #cartPreview {
        width: 360px;
        background: #fff;
        border: 1px solid #eaecf0;
        border-radius: 16px;
        box-shadow: 0 16px 48px rgba(0,0,0,0.12), 0 4px 16px rgba(233,30,140,0.08);
        display: none;
        z-index: 1050;
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        overflow: hidden;
        animation: dropIn 0.22s cubic-bezier(0.4,0,0.2,1);
    }
    @keyframes dropIn {
        from { opacity: 0; transform: translateY(-8px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* HEADER */
    .cart-preview-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #f3f4f6;
        background: var(--pink-soft);
        display: flex; align-items: center; justify-content: space-between;
    }
    .cart-preview-title {
        font-size: 0.875rem; font-weight: 800;
        color: #111; display: flex; align-items: center; gap: 8px; margin: 0;
    }
    .cart-preview-title i { color: var(--pink); }
    .cart-count-pill {
        background: var(--pink); color: #fff;
        font-size: 0.65rem; font-weight: 800;
        padding: 0.18em 0.6em; border-radius: 20px;
        letter-spacing: 0.03em;
    }

    /* ITEMS LIST */
    #cartItemsList {
        max-height: 280px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--pink-light) transparent;
    }
    #cartItemsList::-webkit-scrollbar { width: 4px; }
    #cartItemsList::-webkit-scrollbar-thumb { background: var(--pink-light); border-radius: 4px; }

    /* EMPTY STATE */
    .cart-empty {
        padding: 2.5rem 1rem; text-align: center;
    }
    .cart-empty-icon {
        width: 60px; height: 60px; border-radius: 16px;
        background: var(--pink-soft); border: 1px solid var(--pink-light);
        color: var(--pink); font-size: 1.5rem;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 0.85rem;
    }
    .cart-empty p { font-size: 0.82rem; color: #9ca3af; margin: 0; }

    /* CART ITEM */
    .cart-item-preview {
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid #f5f5f5;
        display: flex; gap: 0.85rem; align-items: center;
        transition: background 0.1s;
    }
    .cart-item-preview:last-child { border-bottom: none; }
    .cart-item-preview:hover { background: var(--pink-soft); }

    .cart-item-image {
        width: 52px; height: 52px; border-radius: 10px;
        object-fit: cover; flex-shrink: 0;
        border: 1px solid #f0f0f0;
        background: #f8f8f8;
    }
    .cart-item-info { flex: 1; min-width: 0; }
    .cart-item-name {
        font-size: 0.82rem; font-weight: 700;
        color: #111; margin-bottom: 2px;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cart-item-details { font-size: 0.72rem; color: #9ca3af; }
    .cart-item-price {
        font-weight: 800; color: var(--pink);
        font-size: 0.875rem; white-space: nowrap;
    }
    .cart-item-remove {
        cursor: pointer; color: #d1d5db;
        transition: all 0.15s; background: none; border: none;
        padding: 4px; border-radius: 6px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.85rem;
    }
    .cart-item-remove:hover { color: #dc2626; background: #fef2f2; }

    /* SUMMARY */
    #cartSummary {
        padding: 1rem 1.25rem;
        border-top: 1px solid #f3f4f6;
        background: #fff;
    }
    .summary-line {
        display: flex; justify-content: space-between; align-items: center;
        font-size: 0.82rem; margin-bottom: 6px;
    }
    .summary-line .s-label { color: #9ca3af; font-weight: 500; }
    .summary-line .s-val   { font-weight: 700; color: #111; }
    .summary-line .s-free  { font-weight: 700; color: #059669; }
    .summary-divider { height: 1px; background: #f3f4f6; margin: 8px 0; }
    .summary-total {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 1rem;
    }
    .summary-total .t-label { font-size: 0.875rem; font-weight: 800; color: #111; }
    .summary-total .t-val   { font-size: 1.2rem; font-weight: 900; color: var(--pink); letter-spacing: -0.02em; }

    .btn-view-cart {
        display: flex; align-items: center; justify-content: center; gap: 6px;
        width: 100%; padding: 0.65rem;
        background: linear-gradient(135deg, var(--pink), var(--pink-dark));
        color: #fff; border: none; border-radius: 10px;
        font-size: 0.85rem; font-weight: 700; cursor: pointer;
        transition: all 0.18s; text-decoration: none;
        box-shadow: 0 4px 12px rgba(233,30,140,0.3);
        margin-bottom: 6px;
    }
    .btn-view-cart:hover { opacity: 0.92; transform: translateY(-1px); color: #fff; }
    .btn-clear-cart {
        display: flex; align-items: center; justify-content: center; gap: 6px;
        width: 100%; padding: 0.55rem;
        background: #fff; border: 1.5px solid #eaecf0;
        color: #6b7280; border-radius: 10px;
        font-size: 0.82rem; font-weight: 600; cursor: pointer;
        transition: all 0.15s;
    }
    .btn-clear-cart:hover { border-color: #dc2626; color: #dc2626; background: #fef2f2; }
</style>

<div class="position-relative">

    <!-- CART BUTTON -->
    <button class="cart-trigger-btn" id="cartPreviewBtn">
        <i class="bi bi-bag"></i>
        <span id="cartBadge">0</span>
    </button>

    <!-- DROPDOWN -->
    <div id="cartPreview">

        <!-- HEADER -->
        <div class="cart-preview-header">
            <h6 class="cart-preview-title">
                <i class="bi bi-bag"></i> Shopping Cart
            </h6>
            <span class="cart-count-pill" id="previewItemCount">0 items</span>
        </div>

        <!-- ITEMS -->
        <div id="cartItemsList">
            <div class="cart-empty">
                <div class="cart-empty-icon"><i class="bi bi-bag-slash"></i></div>
                <p>Your cart is empty</p>
            </div>
        </div>

        <!-- SUMMARY -->
        <div id="cartSummary" style="display:none;">
            <div class="summary-line">
                <span class="s-label">Subtotal</span>
                <span class="s-val" id="previewSubtotal">₱0.00</span>
            </div>
            <div class="summary-line">
                <span class="s-label">Shipping</span>
                <span class="s-free" id="previewShipping">FREE</span>
            </div>
            <div class="summary-divider"></div>
            <div class="summary-total">
                <span class="t-label">Total</span>
                <span class="t-val" id="previewTotal">₱0.00</span>
            </div>
            <a href="{{ path('cart_view') }}" class="btn-view-cart">
                <i class="bi bi-arrow-right-circle"></i> View Cart
            </a>
            <button type="button" class="btn-clear-cart" id="clearCartPreviewBtn">
                <i class="bi bi-trash"></i> Clear Cart
            </button>
        </div>

    </div>
</div>
