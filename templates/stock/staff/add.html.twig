{% extends 'layouts/admin.html.twig' %}
{% block title %}Add Stock - SMSol Studio{% endblock %}
{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ path('staff_stocks') }}">Stock</a></li>
<li class="breadcrumb-item active">Add Stock</li>
{% endblock %}
{% block page_title %}Add Stock{% endblock %}
{% block page_description %}Add stock for a product{% endblock %}
{% block page_actions %}
<a href="{{ path('staff_stocks') }}" class="btn btn-secondary">
    <i class="bi bi-arrow-left me-2"></i>Back to Stock
</a>
{% endblock %}

{% block admin_content %}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card admin-chart">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0">Stock Information</h5>
            </div>
            <div class="card-body">
                {{ form_start(form) }}

                <div class="mb-3">
                    {{ form_label(form.product, 'Product', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.product, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.product) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.quantity, 'Quantity', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.quantity, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.quantity) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.minimumThreshold, 'Minimum Threshold', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.minimumThreshold, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.minimumThreshold) }}
                    <div class="form-text">Alert when stock falls below this level</div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('staff_stocks') }}" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Add Stock
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
