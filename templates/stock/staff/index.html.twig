    </div>
    <button class="btn btn-sm btn-pink-outline" onclick="printStockReport()">
        <i class="bi bi-printer me-1"></i>Print Report
    </button>
</div>




    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="inventoryTable">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Current Stock</th>
                        <th>Min. Stock Level</th>
                        <th>Reorder Point</th>
                        <th>Stock Value</th>
                        <th>Status</th>
                        <th>Last Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for stock in stocks %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                {% if stock.product.photo %}
                                    <img src="{{ asset('uploads/products/' ~ stock.product.photo) }}"
                                         alt="{{ stock.product.name }}"
                                         class="product-thumb">
                                {% else %}
                                    <div class="product-thumb-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                {% endif %}
                                <div>
                                    <div class="fw-600" style="font-weight:600;color:var(--text-main);">{{ stock.product.name }}</div>
                                    <div class="text-muted" style="font-size:.78rem;">{{ stock.product.productType.name|default('N/A') }}</div>
                                </div>
                            </div>
                        </td>
                        <td><span style="font-size:.82rem;color:var(--text-muted);font-family:monospace;">{{ stock.product.sku|default('N/A') }}</span></td>
                        <td><span style="font-weight:700;color:var(--pink-primary);">{{ stock.quantity }}</span></td>
                        <td>{{ stock.minimumThreshold }}</td>
                        <td>{{ stock.minimumThreshold }}</td>
                        <td><span style="font-weight:600;">₱{{ (stock.quantity * stock.product.price)|number_format(2) }}</span></td>
                        <td>
                            {% if stock.quantity <= 0 %}
                                <span class="stock-badge badge-out">Out of Stock</span>
                            {% elseif stock.isIsLowStock %}
                                <span class="stock-badge badge-low-stock">Low Stock</span>
                            {% else %}
                                <span class="stock-badge badge-in-stock">In Stock</span>
                            {% endif %}
                        </td>
                        <td>
                            <small style="color:var(--text-muted);">
                                {{ stock.updatedAt ? stock.updatedAt|date('M d, Y') : stock.createdAt|date('M d, Y') }}
                            </small>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-act-add"
                                        data-bs-toggle="modal" data-bs-target="#addStockModal"
                                        data-product-id="{{ stock.product.id }}"
                                        data-product-name="{{ stock.product.name }}">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                                <button type="button" class="btn btn-act-adjust"
                                        data-bs-toggle="modal" data-bs-target="#adjustStockModal"
                                        data-stock-id="{{ stock.id }}"
                                        data-current-quantity="{{ stock.quantity }}">
                                    <i class="bi bi-pencil"></i> Adjust
                                </button>
                                <button type="button" class="btn btn-act-history"
                                        onclick="viewStockHistory({{ stock.id }})">
                                    <i class="bi bi-clock-history"></i> History
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

