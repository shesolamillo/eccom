{# templates/stock/staff/index.html.twig #}
{% extends 'layouts/admin.html.twig' %}

{% block title %}Stock Management - SMSol Studio{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ path('staff_products') }}">Products</a></li>
<li class="breadcrumb-item active">Stock</li>
{% endblock %}

{% block page_title %}Stock Management{% endblock %}
{% block page_description %}Manage product inventory levels{% endblock %}

{% block page_actions %}
<button class="btn btn-pink-primary" data-bs-toggle="modal" data-bs-target="#importStockModal">
    <i class="bi bi-upload me-2"></i>Import Stock
</button>
{% endblock %}

{% block admin_content %}
<style>
    :root {
        --pink-primary:   #c2185b;
        --pink-secondary: #e91e8c;
        --pink-light:     #f8bbd0;
        --pink-pale:      #fce4ec;
        --pink-dark:      #880e4f;
        --pink-muted:     #ad1457;
        --surface:        #ffffff;
        --surface-alt:    #fafafa;
        --border:         #f0f0f0;
        --text-main:      #2d2d2d;
        --text-muted:     #757575;
    }

    /* ── Buttons ── */
    .btn-pink-primary {
        background-color: var(--pink-primary);
        border-color: var(--pink-primary);
        color: #fff;
        font-weight: 500;
        letter-spacing: .3px;
        border-radius: 8px;
    }
    .btn-pink-primary:hover {
        background-color: var(--pink-dark);
        border-color: var(--pink-dark);
        color: #fff;
    }
    .btn-pink-outline {
        color: var(--pink-primary);
        border-color: var(--pink-light);
        background: transparent;
        font-weight: 500;
        border-radius: 8px;
    }
    .btn-pink-outline:hover {
        background-color: var(--pink-pale);
        border-color: var(--pink-primary);
        color: var(--pink-dark);
    }

    /* ── Cards ── */
    .card {
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 1px 6px rgba(0,0,0,.06);
    }
    .card.admin-chart {
        border: 1px solid var(--border);
        box-shadow: 0 1px 6px rgba(0,0,0,.06);
    }

    /* ── Filter card ── */
    .filter-card {
        border-top: 3px solid var(--pink-primary) !important;
    }
    .filter-card .form-label {
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: var(--text-muted);
    }
    .form-control:focus,
    .form-select:focus {
        border-color: var(--pink-light);
        box-shadow: 0 0 0 3px rgba(194,24,91,.1);
    }

    /* ── Stat cards ── */
    .stats-card {
        border-radius: 12px;
        border: 1px solid var(--border) !important;
        box-shadow: 0 1px 6px rgba(0,0,0,.06);
        transition: transform .18s, box-shadow .18s;
    }
    .stats-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(194,24,91,.12);
    }
    .stats-card .label {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: var(--text-muted);
    }
    .stats-card .value {
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1.1;
    }
    .stats-card.s-total   { border-left: 4px solid var(--pink-primary) !important; }
    .stats-card.s-value   { border-left: 4px solid var(--pink-secondary) !important; }
    .stats-card.s-low     { border-left: 4px solid #f06292 !important; }
    .stats-card.s-out     { border-left: 4px solid var(--pink-dark) !important; }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }
    .stat-icon.i-total   { background: var(--pink-pale); color: var(--pink-primary); }
    .stat-icon.i-value   { background: #fce4ec; color: var(--pink-secondary); }
    .stat-icon.i-low     { background: #fce4ec; color: #e91e63; }
    .stat-icon.i-out     { background: #fce4ec; color: var(--pink-dark); }

    /* ── Table card header ── */
    .table-card-header {
        background: var(--surface);
        border-bottom: 2px solid var(--pink-pale);
        border-radius: 12px 12px 0 0;
        padding: 16px 20px;
    }
    .table-card-header h5 {
        font-weight: 700;
        color: var(--text-main);
        margin: 0;
    }
    .section-accent {
        display: inline-block;
        width: 4px;
        height: 18px;
        background: var(--pink-primary);
        border-radius: 2px;
        margin-right: 10px;
        vertical-align: middle;
    }

    /* ── Table ── */
    #inventoryTable thead tr {
        background-color: var(--pink-pale);
    }
    #inventoryTable thead th {
        color: var(--pink-dark);
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        border-bottom: 2px solid var(--pink-light);
        padding: 12px 16px;
        white-space: nowrap;
    }
    #inventoryTable tbody td {
        padding: 12px 16px;
        vertical-align: middle;
        border-color: var(--border);
        color: var(--text-main);
    }
    #inventoryTable tbody tr:hover {
        background-color: #fff5f8;
    }

    /* ── Product thumbnail ── */
    .product-thumb {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid var(--pink-light);
    }
    .product-thumb-placeholder {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: var(--pink-pale);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--pink-light);
        font-size: 1rem;
        flex-shrink: 0;
    }

    /* ── Badges ── */
    .badge-in-stock  { background-color: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }
    .badge-low-stock { background-color: #fff8e1; color: #f57f17; border: 1px solid #ffe082; }
    .badge-out       { background-color: #fce4ec; color: var(--pink-dark); border: 1px solid var(--pink-light); }
    .stock-badge {
        font-size: .72rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
        letter-spacing: .3px;
    }

    /* ── Action buttons ── */
    .btn-act-add {
        color: #2e7d32;
        border-color: #a5d6a7;
        background: #f1f8f1;
        font-size: .75rem;
        font-weight: 600;
    }
    .btn-act-add:hover {
        background: #2e7d32;
        border-color: #2e7d32;
        color: #fff;
    }
    .btn-act-adjust {
        color: #e65100;
        border-color: #ffcc80;
        background: #fff8f0;
        font-size: .75rem;
        font-weight: 600;
    }
    .btn-act-adjust:hover {
        background: #e65100;
        border-color: #e65100;
        color: #fff;
    }
    .btn-act-history {
        color: var(--pink-primary);
        border-color: var(--pink-light);
        background: var(--pink-pale);
        font-size: .75rem;
        font-weight: 600;
    }
    .btn-act-history:hover {
        background: var(--pink-primary);
        border-color: var(--pink-primary);
        color: #fff;
    }

    /* ── No-stock section ── */
    .no-stock-header {
        background: var(--surface);
        border-bottom: 2px solid var(--pink-pale);
        border-radius: 12px 12px 0 0;
        padding: 16px 20px;
    }
    .no-stock-header h5 {
        font-weight: 700;
        color: var(--text-main);
        margin: 0;
    }
    .btn-add-stock {
        background-color: var(--pink-primary);
        border-color: var(--pink-primary);
        color: #fff;
        font-size: .78rem;
        font-weight: 600;
        border-radius: 6px;
    }
    .btn-add-stock:hover {
        background-color: var(--pink-dark);
        border-color: var(--pink-dark);
        color: #fff;
    }

    /* ── DataTables overrides ── */
    .dataTables_wrapper .dataTables_filter input {
        border-radius: 8px;
        border: 1px solid var(--border);
        padding: 6px 12px;
    }
    .dataTables_wrapper .dataTables_filter input:focus {
        border-color: var(--pink-light);
        box-shadow: 0 0 0 3px rgba(194,24,91,.1);
        outline: none;
    }
    .dataTables_paginate .paginate_button.current,
    .dataTables_paginate .paginate_button.current:hover {
        background: var(--pink-primary) !important;
        border-color: var(--pink-primary) !important;
        color: #fff !important;
        border-radius: 6px;
    }
    .dataTables_paginate .paginate_button:hover {
        background: var(--pink-pale) !important;
        border-color: var(--pink-light) !important;
        color: var(--pink-dark) !important;
        border-radius: 6px;
    }
</style>

<!-- Stock Filters -->
<div class="card filter-card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Product</label>
                <input type="text" class="form-control" name="search"
                       placeholder="Search products..."
                       value="{{ app.request.get('search') }}">
            </div>
            <div class="col-md-3">
                <label class="form-label">Stock Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="in_stock"     {{ app.request.get('status') == 'in_stock'     ? 'selected' : '' }}>In Stock</option>
                    <option value="low_stock"    {{ app.request.get('status') == 'low_stock'    ? 'selected' : '' }}>Low Stock</option>
                    <option value="out_of_stock" {{ app.request.get('status') == 'out_of_stock' ? 'selected' : '' }}>Out of Stock</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Sort By</label>
                <select name="sort" class="form-select">
                    <option value="quantity_asc"  {{ app.request.get('sort') == 'quantity_asc'  ? 'selected' : '' }}>Quantity (Low to High)</option>
                    <option value="quantity_desc" {{ app.request.get('sort') == 'quantity_desc' ? 'selected' : '' }}>Quantity (High to Low)</option>
                    <option value="name_asc"      {{ app.request.get('sort') == 'name_asc'      ? 'selected' : '' }}>Product Name A-Z</option>
                    <option value="name_desc"     {{ app.request.get('sort') == 'name_desc'     ? 'selected' : '' }}>Product Name Z-A</option>
                    <option value="updated_desc"  {{ app.request.get('sort') == 'updated_desc'  ? 'selected' : '' }}>Recently Updated</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-pink-primary w-100">
                    <i class="bi bi-search me-2"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Stock Statistics -->
<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="card stats-card s-total h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="label mb-1">Total Items</p>
                    <p class="value mb-0" style="color:var(--pink-primary);">{{ totalItems|default(0) }}</p>
                </div>
                <div class="stat-icon i-total"><i class="bi bi-box-seam"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stats-card s-value h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="label mb-1">Total Stock Value</p>
                    <p class="value mb-0" style="color:var(--pink-secondary);">₱{{ totalValue|default(0)|number_format(2) }}</p>
                </div>
                <div class="stat-icon i-value"><i class="bi bi-currency-dollar"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stats-card s-low h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="label mb-1">Low Stock Items</p>
                    <p class="value mb-0" style="color:#e91e63;">{{ lowStockItems|default(0) }}</p>
                </div>
                <div class="stat-icon i-low"><i class="bi bi-exclamation-triangle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stats-card s-out h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="label mb-1">Out of Stock</p>
                    <p class="value mb-0" style="color:var(--pink-dark);">{{ outOfStockItems|default(0) }}</p>
                </div>
                <div class="stat-icon i-out"><i class="bi bi-x-circle"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Stock Table -->
