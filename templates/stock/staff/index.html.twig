{% block javascripts %}

{# SheetJS for Excel #}
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
{# jsPDF + autoTable for PDF #}
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>

<script>
{# function exportStock() {
    alert('Exporting stock data...');
    // Implement export functionality
} #}


function getTableData() {
    const rows = [];
    document.querySelectorAll('#inventoryTable tbody tr').forEach(tr => {
        const cells = tr.querySelectorAll('td');
        if (cells.length === 0) return;
        rows.push({
            product:      cells[0].querySelector('strong, div[style]')?.innerText?.trim() || cells[0].innerText.trim(),
            sku:          cells[1].innerText.trim(),
            stock:        cells[2].innerText.trim(),
            minStock:     cells[3].innerText.trim(),
            reorderPoint: cells[4].innerText.trim(),
            stockValue:   cells[5].innerText.trim(),
            status:       cells[6].innerText.trim(),
            lastUpdated:  cells[7].innerText.trim(),
        });
    });
    return rows;
}

const HEADERS = ['Product', 'SKU', 'Current Stock', 'Min. Stock Level', 'Reorder Point', 'Stock Value', 'Status', 'Last Updated'];

function exportCSV() {
    const data = getTableData();
    const csvRows = [HEADERS.join(',')];
    data.forEach(r => {
        csvRows.push([
            `"${r.product}"`, `"${r.sku}"`, r.stock, r.minStock,
            r.reorderPoint, `"${r.stockValue}"`, `"${r.status}"`, `"${r.lastUpdated}"`
        ].join(','));
    });
    const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `stock_inventory_${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
}

function exportExcel() {
    const data = getTableData();
    const wsData = [HEADERS, ...data.map(r => [
        r.product, r.sku, r.stock, r.minStock,
        r.reorderPoint, r.stockValue, r.status, r.lastUpdated
    ])];
    const ws = XLSX.utils.aoa_to_sheet(wsData);

    // Column widths
    ws['!cols'] = [
        {wch:30},{wch:15},{wch:14},{wch:16},
        {wch:14},{wch:14},{wch:14},{wch:14}
    ];

    // Header row style
    HEADERS.forEach((_, i) => {
        const cell = ws[XLSX.utils.encode_cell({r:0, c:i})];
        if (cell) {
            cell.s = {
                font: { bold: true, color: { rgb: 'FFFFFF' } },
                fill: { fgColor: { rgb: 'C2185B' } },
                alignment: { horizontal: 'center' }
            };
        }
    });

    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Stock Inventory');
    XLSX.writeFile(wb, `stock_inventory_${new Date().toISOString().slice(0,10)}.xlsx`);
}

function exportPDF() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation: 'landscape' });

    doc.setFontSize(16);
    doc.setTextColor(194, 24, 91);
    doc.text('Stock Inventory Report', 14, 16);

    doc.setFontSize(9);
    doc.setTextColor(120, 120, 120);
    doc.text(`Generated: ${new Date().toLocaleDateString('en-PH', { year:'numeric', month:'long', day:'numeric' })}`, 14, 23);

    const data = getTableData();
    doc.autoTable({
        startY: 28,
        head: [HEADERS],
        body: data.map(r => [
            r.product, r.sku, r.stock, r.minStock,
            r.reorderPoint, r.stockValue, r.status, r.lastUpdated
        ]),
        headStyles: {
            fillColor: [194, 24, 91],
            textColor: 255,
            fontStyle: 'bold',
            fontSize: 8,
        },
        bodyStyles: { fontSize: 8, textColor: 45 },
        alternateRowStyles: { fillColor: [252, 228, 236] },
        styles: { cellPadding: 3 },
        columnStyles: { 0: { cellWidth: 45 } }
    });

    doc.save(`stock_inventory_${new Date().toISOString().slice(0,10)}.pdf`);
}



function printStockReport() {
    window.print();
}

function viewStockHistory(stockId) {
    window.location.href = `/staff/stock/${stockId}/history`;
}

$(document).ready(function() {
    $('#inventoryTable').DataTable({
        destroy: true,
        pageLength: 25,
        order: [[2, 'asc']],
        language: {
            search: "_INPUT_",
            searchPlaceholder: "Search inventory...",
            lengthMenu: "Show _MENU_ items",
            info: "Showing _START_ to _END_ of _TOTAL_ items",
            infoEmpty: "Showing 0 to 0 of 0 items",
            infoFiltered: "(filtered from _MAX_ total items)"
        }
    });

    $(document).on('click', '[data-bs-target="#addStockModal"]', function() {
        var productId = $(this).data('product-id');
        var productName = $(this).data('product-name');
        console.log('Button clicked, productId:', productId);
        $('#addProductId').val(productId);
        $('#addStockModal .modal-title').text('Add Stock: ' + productName);
    });

    $('#adjustStockModal').on('show.bs.modal', function(event) {
        var button = $(event.relatedTarget);
        var stockId = button.data('stock-id');
        var currentQuantity = button.data('current-quantity');
        var modal = $(this);
        modal.find('#adjustStockId').val(stockId);
        modal.find('#currentQuantity').val(currentQuantity);
        modal.find('#newQuantity').val(currentQuantity);
    });
});
</script>
{% endblock %}
