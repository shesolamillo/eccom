        {# Replace the export buttons in the table-card-header #}
<div class="d-flex gap-2">
    <div class="dropdown">
        <button class="btn btn-sm btn-pink-outline dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-download me-1"></i>Export
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
            <li>
                <a class="dropdown-item" href="#" onclick="exportCSV(); return false;">
