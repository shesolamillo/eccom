// Process payment based on selected method
async function processPayment() {
    const paymentMethod = document.querySelector('input[name="payment_method"]:checked');
    
    if (!paymentMethod) {
        alert('Please select a payment method');
        goToStep(3);
        return;
    }
    
    // Validate cart and address first
    if (Object.keys(cartItems).length === 0) {
        alert('Please add at least one product');
        goToStep(1);
        return;
    }
    
    if (!deliveryType.value) {
        alert('Please select a delivery type');
        goToStep(2);
        return;
    }
    
    if (deliveryType.value === 'delivery') {
        const recipientName = document.querySelector('input[name="recipient_name"]').value;
        const phoneNumber = document.querySelector('input[name="phone_number"]').value;
        const streetAddress = document.querySelector('input[name="street_address"]').value;
        const city = document.querySelector('input[name="city"]').value;
        const postalCode = document.querySelector('input[name="postal_code"]').value;
        
        if (!recipientName || !phoneNumber || !streetAddress || !city || !postalCode) {
            alert('Please fill in all required delivery address fields');
            goToStep(2);
            return;
        }
    }
    
    const totalAmount = parseFloat(document.getElementById('totalAmount').textContent.replace('₱', ''));
    
    // Handle different payment methods
    switch(paymentMethod.value) {
        case 'cash':
            // Cash on Delivery - no payment processing
            await createOrder('pending', null, 'cash');
            break;
            
        case 'card':
            await simulateCardPayment(totalAmount);
            break;
            
        case 'gcash':
            await simulateGCashPayment(totalAmount);
            break;
            
        case 'transfer':
            await simulateBankTransfer(totalAmount);
            break;
            
        default:
            alert('Invalid payment method');
    }
}

// Simulate Card Payment
async function simulateCardPayment(amount) {
    const cardNumber = document.getElementById('cardNumber')?.value;
    const cardExpiry = document.getElementById('cardExpiry')?.value;
    const cardCvv = document.getElementById('cardCvv')?.value;
    const cardholderName = document.getElementById('cardholderName')?.value;
    
    if (!cardNumber || !cardExpiry || !cardCvv || !cardholderName) {
        alert('Please fill in all card details');
        return;
    }
    
    // Basic validation
    const cleanCardNumber = cardNumber.replace(/\s/g, '');
    if (cleanCardNumber.length !== 16) {
        alert('Please enter a valid 16-digit card number');
        return;
    }
    
    if (!cardExpiry.match(/^(0[1-9]|1[0-2])\/\d{2}$/)) {
        alert('Please enter valid expiry date (MM/YY)');
        return;
    }
    
    if (cardCvv.length < 3) {
        alert('Please enter valid CVV');
        return;
    }
    
    // Show loading modal
    showPaymentModal('Processing Card Payment...', 'Please wait while we verify your card details.');
    
    // Simulate payment processing
    let progress = 0;
    const progressInterval = setInterval(() => {
        progress += 10;
        document.getElementById('paymentProgress').style.width = progress + '%';
        if (progress >= 100) clearInterval(progressInterval);
    }, 300);
    
    // Simulate API call delay
    await new Promise(resolve => setTimeout(resolve, 3000));
    
    // Get last 4 digits of card
    const lastFour = cleanCardNumber.slice(-4);
    
    // Payment success message
    const successMsg = `Payment of ₱${amount.toFixed(2)} successfully charged to your card ending in ${lastFour}.`;
    
    // Close payment modal and show success
    paymentModal.hide();
    showSuccessModal(successMsg);
    
    // Create order with payment details
    await createOrder('paid', null, 'card', lastFour, cardholderName);
}

// Simulate GCash Payment
async function simulateGCashPayment(amount) {
    const gcashNumber = document.getElementById('gcashNumber')?.value;
    const gcashName = document.getElementById('gcashName')?.value;
    
    if (!gcashNumber || !gcashName) {
        alert('Please fill in GCash/Maya number and account name');
        return;
    }
    
    // Validate Philippine mobile number
    const cleanNumber = gcashNumber.replace(/\s/g, '');
    if (!cleanNumber.match(/^09\d{9}$/)) {
        alert('Please enter a valid Philippine mobile number (e.g., 09123456789)');
        return;
    }
    
    // Show loading modal
    showPaymentModal('Processing GCash Payment...', `Sending payment request to ${cleanNumber}.`);
    
    // Simulate payment processing
    let progress = 0;
    const progressInterval = setInterval(() => {
        progress += 10;
        document.getElementById('paymentProgress').style.width = progress + '%';
        if (progress >= 100) clearInterval(progressInterval);
    }, 300);
    
    await new Promise(resolve => setTimeout(resolve, 3000));
    
    // Payment success message
    const successMsg = `₱${amount.toFixed(2)} has been deducted from your GCash account (${cleanNumber}). Reference: GCASH-${Date.now()}`;
    
    paymentModal.hide();
    showSuccessModal(successMsg);
    
    await createOrder('paid', null, 'gcash', cleanNumber, gcashName);
}

// Simulate Bank Transfer
