    btn.disabled = !(hasItems && deliverySelected && deliveryFieldsValid && paymentSelected && paymentFieldsValid);
}

// Show/hide payment details
document.querySelectorAll('input[name="payment_method"]').forEach(radio => {
    radio.addEventListener('change', function() {
        // Hide all
        document.getElementById('cardDetails')?.setAttribute('style', 'display: none;');
        document.getElementById('gcashDetails')?.setAttribute('style', 'display: none;');
        document.getElementById('bankDetails')?.setAttribute('style', 'display: none;');
        
        // Show selected
        if (this.value === 'card') {
            document.getElementById('cardDetails')?.setAttribute('style', 'display: block;');
        } else if (this.value === 'gcash') {
            document.getElementById('gcashDetails')?.setAttribute('style', 'display: block;');
        } else if (this.value === 'transfer') {
            document.getElementById('bankDetails')?.setAttribute('style', 'display: block;');
        }
        
        updatePaymentSummary();
        updateCreateButtonState();
    });
});

// Add input listeners for payment fields
document.getElementById('cardNumber')?.addEventListener('input', updateCreateButtonState);
document.getElementById('cardExpiry')?.addEventListener('input', updateCreateButtonState);
document.getElementById('cardCvv')?.addEventListener('input', updateCreateButtonState);
document.getElementById('cardholderName')?.addEventListener('input', updateCreateButtonState);
document.getElementById('gcashNumber')?.addEventListener('input', updateCreateButtonState);
document.getElementById('gcashName')?.addEventListener('input', updateCreateButtonState);
document.getElementById('bankName')?.addEventListener('change', updateCreateButtonState);
document.getElementById('bankAccount')?.addEventListener('input', updateCreateButtonState);
document.getElementById('bankAccountName')?.addEventListener('input', updateCreateButtonState);

// Auto-format card number
document.getElementById('cardNumber')?.addEventListener('input', function(e) {
    let value = e.target.value.replace(/\s/g, '');
    if (value.length > 16) value = value.slice(0, 16);
    value = value.replace(/(\d{4})/g, '$1 ').trim();
    e.target.value = value;
});

// Auto-format expiry date
document.getElementById('cardExpiry')?.addEventListener('input', function(e) {
    let value = e.target.value.replace(/\D/g, '');
    if (value.length >= 2) {
        value = value.slice(0, 2) + '/' + value.slice(2, 4);
    }
    e.target.value = value;
});

// Auto-format GCash number
document.getElementById('gcashNumber')?.addEventListener('input', function(e) {
    let value = e.target.value.replace(/\D/g, '');
    if (value.length > 11) value = value.slice(0, 11);
    if (value.length >= 4) {
        value = value.slice(0, 4) + ' ' + value.slice(4, 7) + ' ' + value.slice(7, 11);
    }
    e.target.value = value.trim();
});

// Update total function
function updateTotal() {
    let subtotal = 0;
    Object.values(cartItems).forEach(item => {
        subtotal += item.quantity * item.price;
    });

    let delivery = deliveryType.value === 'delivery' ? parseFloat(deliveryFeeInput?.value) || 0 : 0;
    let total = subtotal + delivery;

    document.getElementById('subtotal').textContent = '₱' + subtotal.toFixed(2);
    document.getElementById('deliveryFee').textContent = '₱' + delivery.toFixed(2);
    document.getElementById('totalAmount').textContent = '₱' + total.toFixed(2);
    
    updatePaymentAmounts();
    updateCreateButtonState();
    updateDeliverySummary();
}

async function createOrder(paymentStatus, paymentId = null, paymentType = null, accountInfo = null, accountName = null) {
    const btn = document.getElementById('createOrderBtn');
    const selectedPaymentMethod = document.querySelector('input[name="payment_method"]:checked');
    
    const formData = new FormData();
    formData.append('customer_id', customerId.value);
    formData.append('delivery_type', deliveryType.value);
    formData.append('payment_method', selectedPaymentMethod.value);
    formData.append('payment_status', paymentStatus);
    formData.append('is_urgent', document.getElementById('isUrgent').checked ? 1 : 0);
    formData.append('_csrf_token', document.querySelector('input[name="_csrf_token"]').value);
    
    // Add payment details
    if (paymentId) formData.append('payment_reference', paymentId);
    if (accountInfo) formData.append('account_info', accountInfo);
    if (accountName) formData.append('account_name', accountName);
    
    // Add delivery fields
    if (deliveryType.value === 'delivery') {
        formData.append('recipient_name', document.querySelector('input[name="recipient_name"]').value);
        formData.append('phone_number', document.querySelector('input[name="phone_number"]').value);
        formData.append('street_address', document.querySelector('input[name="street_address"]').value);
        formData.append('city', document.querySelector('input[name="city"]').value);
        formData.append('postal_code', document.querySelector('input[name="postal_code"]').value);
        formData.append('barangay', document.querySelector('input[name="barangay"]')?.value || '');
        formData.append('delivery_instructions', document.querySelector('textarea[name="delivery_instructions"]')?.value || '');
        formData.append('delivery_fee', deliveryFeeInput?.value || 0);
    }
    
    // Add items
    let itemCount = 0;
    Object.entries(cartItems).forEach(([id, item]) => {
        formData.append(`items[${itemCount}][product_id]`, id);
        formData.append(`items[${itemCount}][quantity]`, item.quantity);
        itemCount++;
    });
    
    try {
        const response = await fetch('/admin/orders/new', {
            method: 'POST',
            body: formData,
            credentials: 'same-origin'
        });
        
        if (response.ok) {
            const data = await response.json();
            console.log('Order created:', data);
            // Redirect after success modal closes
            setTimeout(() => {
                window.location.href = '{{ path("admin_orders") }}';
            }, 2000);
        } else {
            const text = await response.text();
            alert('Error creating order: ' + text);
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Error creating order: ' + error.message);
    }
}

