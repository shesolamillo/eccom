function goToStep(step) {
    // Hide all step content
    const allSteps = document.querySelectorAll('.checkout-step');
    allSteps.forEach(el => el.classList.remove('active'));
    
    // Reset all step indicators
    for (let i = 1; i <= 3; i++) {
        const stepItem = document.getElementById(`step${i}Item`);
        if (stepItem) {
            // Remove all classes
            stepItem.classList.remove('active', 'completed');
            
            // Get the circle inside
            const circle = stepItem.querySelector('.step-circle');
            if (circle) {
                circle.classList.remove('active', 'completed');
            }
        }
        
        // Reset connectors
        const connector = document.getElementById(`connector${i-1}`);
        if (connector) {
            connector.classList.remove('active', 'completed');
        }
    }
    
    // Mark completed steps (steps before current)
    for (let i = 1; i < step; i++) {
        const stepItem = document.getElementById(`step${i}Item`);
        if (stepItem) {
            stepItem.classList.add('completed');
            const circle = stepItem.querySelector('.step-circle');
            if (circle) {
                circle.classList.add('completed');
            }
        }
        
        const connector = document.getElementById(`connector${i-1}`);
        if (connector && i < step) {
            connector.classList.add('completed');
        }
    }
    
    // Mark current step as active
    const currentStepItem = document.getElementById(`step${step}Item`);
    if (currentStepItem) {
        currentStepItem.classList.add('active');
        const currentCircle = currentStepItem.querySelector('.step-circle');
        if (currentCircle) {
            currentCircle.classList.add('active');
        }
    }
    
    // Mark the connector before current step as active (for visual continuity)
    if (step > 1) {
        const prevConnector = document.getElementById(`connector${step-1}`);
        if (prevConnector) {
            prevConnector.classList.add('active');
        }
    }
    
    // Show the active step content
    const stepContents = {
        1: 'stepCart',
        2: 'stepAddress',
        3: 'stepPayment'
    };
    
    const contentId = stepContents[step];
    if (contentId) {
        document.getElementById(contentId).classList.add('active');
    }
    
    currentStep = step;
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

