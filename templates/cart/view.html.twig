{% extends 'base.html.twig' %}
{% block title %}Shopping Cart - SMSol Studio{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --pink: #e91e8c;
        --pink-dark: #c0166f;
        --pink-light: #fce4f3;
        --pink-soft: #fdf5fb;
        --border: #f0f0f0;
        --text-primary: #111;
        --text-secondary: #4b5563;
        --text-muted: #9ca3af;
        --radius: 16px;
        --shadow: 0 2px 12px rgba(0,0,0,0.06);
        --shadow-pink: 0 8px 32px rgba(233,30,140,0.12);
    }

    body { background: #f8f8f8; }

    /* ── PAGE WRAPPER ── */
    .cart-page { min-height: 100vh; padding: 2.5rem 0; }

    /* ── HEADER ── */
    .cart-header {
        background: linear-gradient(135deg, #fff 55%, var(--pink-soft) 100%);
        border: 1px solid var(--pink-light);
        border-radius: var(--radius);
        padding: 1.75rem 2rem;
        margin-bottom: 1.75rem;
        box-shadow: var(--shadow-pink);
        display: flex; align-items: center; justify-content: space-between;
        position: relative; overflow: hidden;
    }
    .cart-header::after {
        content: '';
        position: absolute; right: -30px; top: -30px;
        width: 160px; height: 160px; border-radius: 50%;
        background: radial-gradient(circle, rgba(233,30,140,0.07) 0%, transparent 70%);
    }
    .cart-header-title {
        font-size: 1.5rem; font-weight: 900;
        color: var(--text-primary); letter-spacing: -0.02em; margin: 0;
    }
    .cart-header-title span { color: var(--pink); }
    .cart-header-sub { font-size: 0.85rem; color: var(--text-muted); margin-top: 3px; }
    .cart-count-pill {
        background: var(--pink); color: #fff;
        font-size: 0.72rem; font-weight: 700;
        padding: 0.3em 0.85em; border-radius: 20px;
        letter-spacing: 0.04em;
    }

    /* ── LAYOUT ── */
    .cart-layout {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 1.5rem;
        align-items: start;
    }

    /* ── ITEMS CARD ── */
    .items-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }
    .items-card-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.72rem; font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.09em;
        color: var(--text-muted);
        background: #fafafa;
    }

    /* ── CART ITEM ── */
    .cart-item {
        display: flex; align-items: center; gap: 1rem;
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid #f8f8f8;
        transition: background 0.12s;
    }
    .cart-item:last-child { border-bottom: none; }
    .cart-item:hover { background: var(--pink-soft); }

    .item-img {
        width: 80px; height: 80px; border-radius: 12px;
        overflow: hidden; flex-shrink: 0;
        background: #f5f5f5;
        border: 1px solid var(--border);
        display: flex; align-items: center; justify-content: center;
    }
    .item-img img { width: 100%; height: 100%; object-fit: cover; }
    .item-img i { font-size: 1.5rem; color: var(--text-muted); }

    .item-info { flex-grow: 1; min-width: 0; }
    .item-name {
        font-size: 0.9rem; font-weight: 700;
        color: var(--text-primary); margin-bottom: 4px;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .item-meta { display: flex; gap: 6px; flex-wrap: wrap; }
    .item-tag {
        font-size: 0.65rem; font-weight: 700;
        padding: 0.18em 0.6em; border-radius: 4px;
        text-transform: uppercase; letter-spacing: 0.04em;
    }
    .tag-type  { background: var(--pink-light); color: var(--pink); }
    .tag-warn  { background: #fef3c7; color: #92400e; }

    .item-unit-price {
        font-size: 0.82rem; color: var(--text-muted);
        font-weight: 500; min-width: 80px; text-align: right;
    }

    /* QTY CONTROL */
    .qty-wrap {
        display: flex; align-items: center;
        background: #f9fafb;
        border: 1.5px solid var(--border);
        border-radius: 8px; overflow: hidden;
        min-width: 110px;
    }
    .btn-qty {
        width: 34px; height: 34px; border: none;
        background: transparent; cursor: pointer;
        font-size: 1rem; font-weight: 700;
        color: var(--text-secondary);
        transition: all 0.15s;
        display: flex; align-items: center; justify-content: center;
    }
    .btn-qty:hover { background: var(--pink-soft); color: var(--pink); }
    .qty-input {
        flex: 1; border: none; background: transparent;
        text-align: center; font-weight: 800;
        font-size: 0.9rem; color: var(--text-primary);
        padding: 0; width: 36px;
    }

    .item-subtotal {
        font-size: 0.95rem; font-weight: 800;
        color: var(--pink); min-width: 90px; text-align: right;
    }

    .btn-remove {
        width: 34px; height: 34px; border: none;
        background: #fff5f5; color: #dc2626;
        border-radius: 8px; cursor: pointer;
        transition: all 0.15s; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.85rem;
        border: 1px solid #fecaca;
    }
    .btn-remove:hover { background: #dc2626; color: #fff; }

    /* CONTINUE SHOPPING */
    .btn-continue-shop {
        display: flex; align-items: center; gap: 6px;
        padding: 0.85rem 1.5rem;
        font-size: 0.82rem; font-weight: 600;
        color: var(--text-muted); text-decoration: none;
        border-top: 1px solid var(--border);
        transition: color 0.15s;
        background: #fafafa;
    }
    .btn-continue-shop:hover { color: var(--pink); }

    /* ── ORDER SUMMARY ── */
    .summary-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow-pink);
        overflow: hidden;
        position: sticky; top: 20px;
    }
    .summary-header {
        background: linear-gradient(135deg, var(--pink), var(--pink-dark));
        padding: 1.1rem 1.5rem;
        display: flex; align-items: center; gap: 8px;
    }
    .summary-header-title {
        font-size: 0.9rem; font-weight: 800;
        color: #fff; margin: 0;
    }
    .summary-body { padding: 1.25rem; }

    .s-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.6rem 0; border-bottom: 1px solid #f8f8f8;
        font-size: 0.875rem;
    }
    .s-row:last-of-type { border-bottom: none; }
    .s-row .s-label { color: var(--text-muted); font-weight: 500; }
    .s-row .s-val   { font-weight: 700; color: var(--text-primary); }
    .s-row .s-free  { color: #059669; font-weight: 700; }
    .s-row .s-disc  { color: #059669; font-weight: 700; }

    .summary-divider { height: 1px; background: #f0f0f0; margin: 0.75rem 0; }

    .total-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.5rem 0;
    }
    .total-label { font-size: 0.875rem; font-weight: 800; color: var(--text-primary); }
    .total-val   { font-size: 1.5rem; font-weight: 900; color: var(--pink); letter-spacing: -0.02em; }

    /* BUTTONS */
    .btn-buy {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; padding: 0.85rem;
        background: linear-gradient(135deg, var(--pink), var(--pink-dark));
        color: #fff; border: none; border-radius: 10px;
        font-size: 0.9rem; font-weight: 700; cursor: pointer;
        transition: all 0.18s; text-decoration: none;
        box-shadow: 0 4px 14px rgba(233,30,140,0.3);
        margin-bottom: 0.6rem;
    }
    .btn-buy:hover {
        opacity: 0.92; transform: translateY(-1px); color: #fff;
        box-shadow: 0 6px 20px rgba(233,30,140,0.4);
    }
    .btn-clear {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; padding: 0.7rem;
        background: #fff; border: 1.5px solid var(--border);
        color: var(--text-muted); border-radius: 10px;
        font-size: 0.85rem; font-weight: 600; cursor: pointer;
        transition: all 0.15s;
    }
    .btn-clear:hover { border-color: #dc2626; color: #dc2626; background: #fff5f5; }

    /* SECURITY */
    .security-box {
        background: #ecfdf3; border: 1px solid #a7f3d0;
        border-radius: 10px; padding: 0.85rem 1rem;
        display: flex; align-items: center; gap: 10px;
        margin-top: 0.75rem;
    }
    .security-box i { color: #059669; font-size: 1.1rem; flex-shrink: 0; }
    .security-box .s-title { font-size: 0.78rem; font-weight: 700; color: #065f46; }
    .security-box .s-sub   { font-size: 0.72rem; color: #6b7280; }

    /* ── EMPTY STATE ── */
    .empty-cart {
        text-align: center; padding: 5rem 2rem;
        background: #fff; border-radius: var(--radius);
        box-shadow: var(--shadow);
    }
    .empty-icon {
        width: 100px; height: 100px; border-radius: 24px;
        background: var(--pink-soft); border: 1px solid var(--pink-light);
        color: var(--pink); font-size: 2.5rem;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.5rem;
        box-shadow: 0 4px 20px rgba(233,30,140,0.15);
    }
    .empty-cart h3 { font-weight: 800; color: var(--text-primary); margin-bottom: 6px; }
    .empty-cart p  { color: var(--text-muted); margin-bottom: 1.5rem; }
    .btn-shop {
        background: var(--pink); color: #fff; border: none;
        border-radius: 10px; font-size: 0.875rem; font-weight: 700;
        padding: 0.7rem 1.5rem; text-decoration: none;
        display: inline-flex; align-items: center; gap: 6px;
        box-shadow: 0 4px 14px rgba(233,30,140,0.3);
        transition: all 0.18s;
    }
    .btn-shop:hover { background: var(--pink-dark); color: #fff; transform: translateY(-1px); }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .cart-item { animation: fadeInUp 0.3s ease both; }

    @media (max-width: 768px) {
        .cart-layout { grid-template-columns: 1fr; }
        .summary-card { position: static; }
        .cart-item { flex-wrap: wrap; }
        .item-unit-price, .item-subtotal { min-width: auto; }
    }
</style>
{% endblock %}

{% block body %}
<div class="cart-page">
<div class="container">

{% if items is empty %}
    <div class="empty-cart">
        <div class="empty-icon"><i class="bi bi-bag-x"></i></div>
        <h3>Your cart is empty</h3>
        <p>Looks like you haven't added anything yet.</p>
        <a href="{{ path('app_products') }}" class="btn-shop">
            <i class="bi bi-shop"></i> Start Shopping
        </a>
    </div>

{% else %}

    <!-- HEADER -->
    <div class="cart-header">
        <div>
            <h1 class="cart-header-title">My <span>Cart</span></h1>
            <div class="cart-header-sub">Review your selected items before checkout</div>
        </div>
        <span class="cart-count-pill">{{ items|length }} item{{ items|length > 1 ? 's' : '' }}</span>
    </div>

    <div class="cart-layout">

        <!-- ITEMS -->
        <div class="items-card">
            <div class="items-card-header">Your Items</div>

            {% for item in items %}
            <div class="cart-item">
                <div class="item-img">
                    {% if item.product.photo %}
                        <img src="{{ asset('uploads/products/' ~ item.product.photo) }}"
                             alt="{{ item.product.name }}">
                    {% else %}
                        <i class="bi bi-image"></i>
                    {% endif %}
                </div>

                <div class="item-info">
                    <div class="item-name">{{ item.product.name }}</div>
                    <div class="item-meta">
                        {% if item.product.productType %}
                            <span class="item-tag tag-type">{{ item.product.productType.name }}</span>
                        {% endif %}
                        {% if item.stock_available < 5 %}
                            <span class="item-tag tag-warn">
                                <i class="bi bi-exclamation-circle me-1"></i>Only {{ item.stock_available }} left
                            </span>
                        {% endif %}
                    </div>
                </div>

                <div class="item-unit-price">₱{{ item.price|number_format(2) }}</div>

                <div class="qty-wrap">
                    <button class="btn-qty btn-decrement" data-product-id="{{ item.id }}" type="button">−</button>
                    <input type="text" class="qty-input" data-product-id="{{ item.id }}"
                           value="{{ item.quantity }}" readonly>
                    <button class="btn-qty btn-increment" data-product-id="{{ item.id }}" type="button">+</button>
                </div>

                <div class="item-subtotal">₱{{ item.subtotal|number_format(2) }}</div>

                <button class="btn-remove" data-product-id="{{ item.id }}" type="button" title="Remove">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
            {% endfor %}

            <a href="{{ path('app_products') }}" class="btn-continue-shop">
                <i class="bi bi-chevron-left"></i> Continue Shopping
            </a>
        </div>

        <!-- SUMMARY -->
        <div class="summary-card">
            <div class="summary-header">
                <i class="bi bi-receipt" style="color:#fff;font-size:1rem"></i>
                <h5 class="summary-header-title">Order Summary</h5>
            </div>
            <div class="summary-body">
                <div class="s-row">
                    <span class="s-label">Subtotal</span>
                    <span class="s-val">₱{{ subtotal|number_format(2) }}</span>
                </div>
                <div class="s-row">
                    <span class="s-label">Discount</span>
                    <span class="s-disc">−₱0.00</span>
                </div>
                <div class="s-row">
                    <span class="s-label">Shipping</span>
                    {% if shipping == 0 %}
                        <span class="s-free">FREE</span>
                    {% else %}
                        <span class="s-val">₱{{ shipping|number_format(2) }}</span>
                    {% endif %}
                </div>

                <div class="summary-divider"></div>

                <div class="total-row">
                    <span class="total-label">Total</span>
                    <span class="total-val">₱{{ total|number_format(2) }}</span>
                </div>

                {# <div style="margin-top:1.25rem">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_order_new') }}?step=2" class="btn-buy">
                            <i class="bi bi-cart-check"></i> Buy Now
                        </a>
                    {% else %}
                        <a href="{{ path('app_user_order_create') }}" class="btn-buy">
                            <i class="bi bi-cart-check"></i> Buy Now
                        </a>
                    {% endif %}
                    <button type="button" class="btn-clear" id="cancelCartBtn">
                        <i class="bi bi-trash"></i> Clear Cart
                    </button>
                </div> #}

                <div style="margin-top:1.25rem">
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('admin_order_new') }}?step=2" class="btn-buy">
            <i class="bi bi-cart-check"></i> Buy Now
        </a>
    {% elseif is_granted('ROLE_STAFF') %}
        <a href="{{ path('staff_order_new') }}?step=2" class="btn-buy">
            <i class="bi bi-cart-check"></i> Buy Now
        </a>
    {% else %}
        <a href="{{ path('app_user_order_create') }}" class="btn-buy">
            <i class="bi bi-cart-check"></i> Buy Now
        </a>
    {% endif %}
    <button type="button" class="btn-clear" id="cancelCartBtn">
        <i class="bi bi-trash"></i> Clear Cart
    </button>
</div>


                <div class="security-box">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <div class="s-title">Safe & Secure Checkout</div>
                        <div class="s-sub">Easy returns. 100% Authentic products.</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endif %}

</div>
</div>

