{# templates/settings/user/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Account Settings - SMSol Studio{% endblock %}

{% block body %}
<style>
:root {
    --pink: #c2185b; --pink-dark: #880e4f;
    --pink-light: #fce4ec; --pink-soft: #fdf5fb;
    --border: #eaecf0; --surface: #ffffff;
    --surface-2: #f8f9fb; --text-primary: #101828;
    --text-secondary: #475467; --text-muted: #98a2b3;
    --radius: 12px; --shadow: 0 1px 4px rgba(16,24,40,0.06);
}
.settings-wrap { max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
.page-head { margin-bottom: 1.5rem; }
.page-head h4 { font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.02em; }
.page-head p  { color: var(--text-muted); font-size: 0.82rem; margin: 2px 0 0; }
.settings-tabs { display: flex; gap: 4px; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; padding: 4px; margin-bottom: 1.5rem; overflow-x: auto; }
.s-tab { flex: 1; min-width: 100px; padding: 0.55rem 1rem; border: none; background: transparent; border-radius: 8px; font-size: 0.82rem; font-weight: 600; color: var(--text-muted); cursor: pointer; transition: all 0.15s; display: flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; }
.s-tab:hover { color: var(--pink); }
.s-tab.active { background: var(--surface); color: var(--pink); box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
.s-panel { display: none; }
.s-panel.active { display: block; }
.s-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 1rem; overflow: hidden; }
.s-card-head { padding: 0.85rem 1.25rem; border-bottom: 1px solid var(--border); background: var(--surface-2); display: flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 700; color: var(--text-primary); }
.s-card-head::before { content: ''; width: 3px; height: 16px; background: var(--pink); border-radius: 3px; }
.s-card-body { padding: 1.25rem; }
.field-row { display: grid; grid-template-columns: 180px 1fr; gap: 1rem; align-items: start; padding: 0.75rem 0; border-bottom: 1px solid #f3f4f6; }
.field-row:last-child { border-bottom: none; padding-bottom: 0; }
.field-row:first-child { padding-top: 0; }
.field-name { font-size: 0.82rem; font-weight: 600; color: var(--text-primary); margin-bottom: 2px; }
.field-desc { font-size: 0.72rem; color: var(--text-muted); line-height: 1.4; }
.f-input, .f-select, .f-textarea { border: 1.5px solid var(--border); border-radius: 8px; font-size: 0.85rem; padding: 0.5rem 0.85rem; color: var(--text-primary); background: var(--surface); width: 100%; transition: border-color 0.15s, box-shadow 0.15s; }
.f-input:focus, .f-select:focus, .f-textarea:focus { border-color: var(--pink); box-shadow: 0 0 0 3px rgba(194,24,91,0.1); outline: none; }
.f-textarea { resize: vertical; min-height: 80px; }
.form-check-input:checked { background-color: var(--pink); border-color: var(--pink); }
.form-check-input { width: 2.5rem; height: 1.3rem; cursor: pointer; }
.btn-save { background: var(--pink); color: #fff; border: none; border-radius: 8px; padding: 0.6rem 1.5rem; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.15s; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(194,24,91,0.25); }
.btn-save:hover { background: var(--pink-dark); }
.btn-cancel { background: var(--surface); border: 1.5px solid var(--border); color: var(--text-secondary); border-radius: 8px; padding: 0.6rem 1.25rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.15s; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
.btn-cancel:hover { border-color: var(--pink); color: var(--pink); }
.btn-danger-outline { background: var(--surface); border: 1.5px solid #fca5a5; color: #dc2626; border-radius: 8px; padding: 0.6rem 1.25rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.15s; display: inline-flex; align-items: center; gap: 6px; }
.btn-danger-outline:hover { background: #fef2f2; border-color: #ef4444; }
.avatar-wrap { display: flex; align-items: center; gap: 1rem; }
.avatar-circle { width: 72px; height: 72px; border-radius: 50%; background: var(--pink-light); display: flex; align-items: center; justify-content: center; font-size: 1.6rem; color: var(--pink); font-weight: 700; flex-shrink: 0; overflow: hidden; border: 3px solid var(--pink-light); }
.avatar-circle img { width: 100%; height: 100%; object-fit: cover; }
.btn-upload { background: var(--surface); border: 1.5px solid var(--border); color: var(--text-secondary); border-radius: 8px; padding: 0.45rem 1rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.15s; display: inline-flex; align-items: center; gap: 5px; }
.btn-upload:hover { border-color: var(--pink); color: var(--pink); }
.notif-row { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid #f3f4f6; }
.notif-row:last-child { border-bottom: none; }
.notif-title { font-size: 0.82rem; font-weight: 600; color: var(--text-primary); }
.notif-desc  { font-size: 0.72rem; color: var(--text-muted); }
.pwd-strength { height: 4px; border-radius: 2px; margin-top: 6px; transition: all 0.3s; background: var(--border); }
.address-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
.danger-zone { background: #fff5f5; border: 1px solid #fecaca; border-radius: var(--radius); padding: 1.25rem; }
.danger-zone-title { font-size: 0.82rem; font-weight: 700; color: #dc2626; margin-bottom: 4px; display: flex; align-items: center; gap: 6px; }
.danger-zone-desc { font-size: 0.75rem; color: #9ca3af; margin-bottom: 1rem; }
@media(max-width:640px) {
    .field-row { grid-template-columns: 1fr; }
    .address-grid { grid-template-columns: 1fr; }
}
</style>

<div class="settings-wrap">
    <div class="page-head">
        <h4>Account Settings</h4>
        <p>Manage your profile, security, and preferences</p>
    </div>

    <div class="settings-tabs">
        <button class="s-tab active" onclick="switchTab('profile', this)"><i class="bi bi-person"></i> Profile</button>
        <button class="s-tab" onclick="switchTab('address', this)"><i class="bi bi-geo-alt"></i> Address</button>
        <button class="s-tab" onclick="switchTab('security', this)"><i class="bi bi-shield-lock"></i> Security</button>
        <button class="s-tab" onclick="switchTab('notifications', this)"><i class="bi bi-bell"></i> Notifications</button>
        <button class="s-tab" onclick="switchTab('account', this)"><i class="bi bi-person-gear"></i> Account</button>
    </div>

    {# --- PROFILE --- #}
    <div class="s-panel active" id="tab-profile">
        <form action="{{ path('user_settings_profile') }}" method="post" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('user_profile') }}">
            <div class="s-card">
                <div class="s-card-head"><i class="bi bi-person-circle"></i> Profile Photo</div>
                <div class="s-card-body">
                    <div class="avatar-wrap">
                        <div class="avatar-circle" id="avatarPreview">
                            {% if app.user.photo is defined and app.user.photo %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.photo) }}" alt="Avatar">
                            {% else %}
                                {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                            {% endif %}
                        </div>
                        <div>
                            <label class="btn-upload" for="photoInput">
                                <i class="bi bi-upload"></i> Upload Photo
                            </label>
                            <input type="file" id="photoInput" name="photo" accept="image/*"
                                   style="display:none;" onchange="previewAvatar(this)">
                            <div style="font-size:0.72rem;color:var(--text-muted);margin-top:4px;">JPG, PNG up to 2MB</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="s-card">
                <div class="s-card-head"><i class="bi bi-info-circle"></i> Personal Information</div>
                <div class="s-card-body">
                    <div class="field-row">
                        <div><div class="field-name">First Name</div></div>
                        <input type="text" name="firstName" class="f-input" value="{{ app.user.firstName }}" required>
                    </div>
                    <div class="field-row">
                        <div><div class="field-name">Last Name</div></div>
                        <input type="text" name="lastName" class="f-input" value="{{ app.user.lastName }}" required>
                    </div>
                    <div class="field-row">
                        <div>
                            <div class="field-name">Email Address</div>
                            <div class="field-desc">Used for login and order updates</div>
                        </div>
                        <input type="email" name="email" class="f-input" value="{{ app.user.email }}" required>
                    </div>
                    <div class="field-row">
                        <div><div class="field-name">Phone Number</div></div>
                        <input type="text" name="phone" class="f-input"
                               value="{{ app.user.phone|default('') }}" placeholder="+63 9XX XXX XXXX">
                    </div>
                    <div class="field-row">
                        <div><div class="field-name">Birthday</div></div>
                        <input type="date" name="birthday" class="f-input"
                               value="{{ app.user.birthday is defined and app.user.birthday ? app.user.birthday|date('Y-m-d') : '' }}">
                    </div>
                    <div class="field-row">
                        <div>
                            <div class="field-name">Bio</div>
                            <div class="field-desc">Short description about yourself</div>
                        </div>
                        <textarea name="bio" class="f-textarea" placeholder="Tell us a little about yourself...">{{ app.user.bio|default('') }}</textarea>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="reset" class="btn-cancel"><i class="bi bi-x"></i> Cancel</button>
                <button type="submit" class="btn-save"><i class="bi bi-check-lg"></i> Save Profile</button>
            </div>
        </form>
    </div>

    {# --- ADDRESS --- #}
    <div class="s-panel" id="tab-address">
        <form action="{{ path('user_settings_address') }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('user_address') }}">
            <div class="s-card">
                <div class="s-card-head"><i class="bi bi-house"></i> Default Shipping Address</div>
                <div class="s-card-body">
                    <div class="field-row">
                        <div><div class="field-name">Street Address</div></div>
                        <input type="text" name="street" class="f-input"
                               value="{{ app.user.address.street|default('') }}" placeholder="House no., Street name">
                    </div>
                    <div class="field-row">
                        <div><div class="field-name">Barangay</div></div>
                        <input type="text" name="barangay" class="f-input"
                               value="{{ app.user.address.barangay|default('') }}">
                    </div>
                    <div class="field-row">
                        <div><div class="field-name">City / Municipality</div></div>
                        <div class="address-grid">
                            <input type="text" name="city" class="f-input"
                                   value="{{ app.user.address.city|default('') }}" placeholder="City">
                            <input type="text" name="province" class="f-input"
                                   value="{{ app.user.address.province|default('') }}" placeholder="Province">
                        </div>
                    </div>
                    <div class="field-row">
                        <div><div class="field-name">ZIP Code</div></div>
                        <input type="text" name="zip" class="f-input"
                               value="{{ app.user.address.zip|default('') }}"
                               placeholder="e.g. 6000" style="max-width:160px;">
                    </div>
                    <div class="field-row">
                        <div><div class="field-name">Country</div></div>
                        <select name="country" class="f-select" style="max-width:240px;">
                            <option value="PH" {{ app.user.address.country|default('PH') == 'PH' ? 'selected' : '' }}>Philippines</option>
                            <option value="US" {{ app.user.address.country|default('PH') == 'US' ? 'selected' : '' }}>United States</option>
                            <option value="SG" {{ app.user.address.country|default('PH') == 'SG' ? 'selected' : '' }}>Singapore</option>
                            <option value="AU" {{ app.user.address.country|default('PH') == 'AU' ? 'selected' : '' }}>Australia</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" class="btn-save"><i class="bi bi-check-lg"></i> Save Address</button>
            </div>
        </form>
    </div>

    {# --- SECURITY --- #}
    <div class="s-panel" id="tab-security">
        <form action="{{ path('user_settings_password') }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('user_password') }}">
            <div class="s-card">
                <div class="s-card-head"><i class="bi bi-key"></i> Change Password</div>
                <div class="s-card-body">
                    <div class="field-row">
                        <div><div class="field-name">Current Password</div></div>
                        <input type="password" name="current_password" class="f-input"
                               placeholder="Enter current password" required>
                    </div>
                    <div class="field-row">
                        <div>
                            <div class="field-name">New Password</div>
                            <div class="field-desc">Minimum 8 characters</div>
                        </div>
                        <div>
                            <input type="password" name="new_password" id="newPwd" class="f-input"
                                   placeholder="Enter new password" required onkeyup="checkStrength(this.value)">
                            <div class="pwd-strength" id="pwdStrength"></div>
                            <div id="pwdStrengthLabel" style="font-size:0.72rem;color:var(--text-muted);margin-top:3px;"></div>
                        </div>
                    </div>
                    <div class="field-row">
                        <div><div class="field-name">Confirm Password</div></div>
                        <div>
                            <input type="password" name="confirm_password" id="confirmPwd" class="f-input"
                                   placeholder="Repeat new password" required onkeyup="checkMatch()">
                            <div id="matchLabel" style="font-size:0.72rem;margin-top:3px;"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" class="btn-save"><i class="bi bi-shield-lock"></i> Update Password</button>
            </div>
        </form>
    </div>

    {# --- NOTIFICATIONS --- #}
    <div class="s-panel" id="tab-notifications">
        <form action="{{ path('user_settings_notifications') }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('user_notifications') }}">
            <div class="s-card">
                <div class="s-card-head"><i class="bi bi-envelope-bell"></i> Email Notifications</div>
                <div class="s-card-body">
                    <div class="notif-row">
                        <div>
                            <div class="notif-title">Order Confirmation</div>
                            <div class="notif-desc">Receive an email when your order is placed</div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="notif_order_confirm"
                                   {{ app.user.notifOrderConfirm|default(true) ? 'checked' : '' }}>
                        </div>
                    </div>
                    <div class="notif-row">
                        <div>
                            <div class="notif-title">Order Shipped</div>
                            <div class="notif-desc">Get notified when your order is on the way</div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="notif_order_shipped"
                                   {{ app.user.notifOrderShipped|default(true) ? 'checked' : '' }}>
                        </div>
                    </div>
                    <div class="notif-row">
                        <div>
                            <div class="notif-title">Order Delivered</div>
                            <div class="notif-desc">Confirmation when your order is delivered</div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="notif_order_delivered"
                                   {{ app.user.notifOrderDelivered|default(true) ? 'checked' : '' }}>
                        </div>
                    </div>
                    <div class="notif-row">
                        <div>
                            <div class="notif-title">Promotions &amp; Offers</div>
                            <div class="notif-desc">Sales, discounts, and special offers</div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="notif_promos"
                                   {{ app.user.notifPromos|default(false) ? 'checked' : '' }}>
                        </div>
                    </div>
                    <div class="notif-row">
                        <div>
                            <div class="notif-title">Newsletter</div>
                            <div class="notif-desc">Monthly updates and product news</div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="notif_newsletter"
                                   {{ app.user.notifNewsletter|default(false) ? 'checked' : '' }}>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" class="btn-save"><i class="bi bi-check-lg"></i> Save Notifications</button>
            </div>
        </form>
    </div>

    {# --- ACCOUNT --- #}
    <div class="s-panel" id="tab-account">
        <div class="s-card">
            <div class="s-card-head"><i class="bi bi-person-badge"></i> Account Information</div>
            <div class="s-card-body">
                <div class="field-row">
                    <div><div class="field-name">Member Since</div></div>
                    <div style="font-size:0.85rem;color:var(--text-secondary);padding-top:2px;">
                        {{ app.user.createdAt is defined ? app.user.createdAt|date('F d, Y') : '—' }}
                    </div>
                </div>
                <div class="field-row">
                    <div><div class="field-name">Account Role</div></div>
                    <div style="padding-top:2px;">
                        <span style="background:var(--pink-light);color:var(--pink);font-size:0.72rem;font-weight:700;padding:0.2em 0.7em;border-radius:20px;">
                            {{ app.user.roles|first|replace({'ROLE_': ''})|title }}
                        </span>
                    </div>
                </div>
                <div class="field-row">
                    <div><div class="field-name">Email</div></div>
                    <div style="font-size:0.85rem;color:var(--text-secondary);padding-top:2px;">
                        {{ app.user.email }}
                    </div>
                </div>
            </div>
        </div>
        <div class="s-card">
            <div class="s-card-head" style="color:#dc2626;">
                <i class="bi bi-exclamation-triangle" style="color:#dc2626;"></i> Danger Zone
            </div>
            <div class="s-card-body">
                <div class="danger-zone">
                    <div class="danger-zone-title"><i class="bi bi-trash3"></i> Delete Account</div>
                    <div class="danger-zone-desc">Permanently delete your account and all associated data. This action cannot be undone.</div>
                    <button type="button" class="btn-danger-outline" onclick="confirmDelete()">
                        <i class="bi bi-trash3"></i> Delete My Account
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function switchTab(name, el) {
    document.querySelectorAll('.s-panel').forEach(function(p) { p.classList.remove('active'); });
    document.querySelectorAll('.s-tab').forEach(function(t) { t.classList.remove('active'); });
    document.getElementById('tab-' + name).classList.add('active');
    el.classList.add('active');
}

function previewAvatar(input) {
    if (!input.files[0]) return;
    var reader = new FileReader();
    reader.onload = function(e) {
        var wrap = document.getElementById('avatarPreview');
        wrap.innerHTML = '<img src="' + e.target.result + '" alt="Preview" style="width:100%;height:100%;object-fit:cover;">';
    };
    reader.readAsDataURL(input.files[0]);
}

function checkStrength(val) {
    var bar   = document.getElementById('pwdStrength');
    var label = document.getElementById('pwdStrengthLabel');
    var score = 0;
    if (val.length >= 8)          score += 1;
    if (/[A-Z]/.test(val))        score += 1;
    if (/[0-9]/.test(val))        score += 1;
    if (/[^A-Za-z0-9]/.test(val)) score += 1;
    var colors = ['#ef4444','#f97316','#eab308','#22c55e'];
    var labels = ['Weak','Fair','Good','Strong'];
    bar.style.width      = (score * 25) + '%';
    bar.style.background = score > 0 ? colors[score - 1] : '#eaecf0';
    label.textContent    = score > 0 ? labels[score - 1] : '';
    label.style.color    = score > 0 ? colors[score - 1] : 'var(--text-muted)';
}

function checkMatch() {
    var pwd    = document.getElementById('newPwd').value;
    var conf   = document.getElementById('confirmPwd').value;
    var label  = document.getElementById('matchLabel');
    if (!conf) { label.textContent = ''; return; }
    if (pwd === conf) {
        label.textContent = 'Passwords match';
        label.style.color = '#22c55e';
    } else {
        label.textContent = 'Passwords do not match';
        label.style.color = '#ef4444';
    }
}

function confirmDelete() {
    if (confirm('Are you sure you want to delete your account? This cannot be undone.')) {
        window.location.href = '{{ path("user_account_delete") }}';
    }
}
</script>
{% endblock %}
