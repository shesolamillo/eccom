{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SMSol Studio - Clothing Store{% endblock %}</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">

    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    

    
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="{{ path('app_home') }}">
                <img src="{{ asset('uploads/images/logo.png') }}" style="height: 40px; width: auto;" class="me-2">
                SMSol Studio
            </a>

            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_home' ? 'active' : '' }}" 
                           href="{{ path('app_home') }}">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_services' ? 'active' : '' }}" 
                           href="{{ path('app_services') }}">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_about' ? 'active' : '' }}" 
                           href="{{ path('app_about') }}">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_contact' ? 'active' : '' }}" 
                           href="{{ path('app_contact') }}">Contact</a>
                    </li>
                    
                    {% if is_granted('ROLE_USER') %}
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.get('_route') == 'app_products' ? 'active' : '' }}" 
                               href="{{ path('app_products') }}">Products</a>
                        </li>
                    {% endif %}
                </ul>
                
                <ul class="navbar-nav">
                    {% if app.user and is_granted('ROLE_USER') %}
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.get('_route') == 'cart_view' ? 'active' : '' }}" 
                               href="{{ path('cart_view') }}">
                                <i class="bi bi-bag-check me-1"></i>Cart
                            </a>
                        </li>
                    {% endif %}

                    {% if app.user and not is_granted('ROLE_ADMIN') and not is_granted('ROLE_STAFF') %}
                        {# ── Notification Bell (User) ── #}
                        <li class="nav-item dropdown me-1">
                            <a class="nav-link position-relative" href="#" role="button" data-bs-toggle="dropdown" title="Notifications">
                                <i class="bi bi-bell-fill" style="font-size:1.2rem;"></i>
                                <span id="notification-badge"
                                      class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark"
                                      style="font-size:0.65rem; display:none;">0</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" style="min-width:300px; max-height:380px; overflow-y:auto;">
                                <li class="px-3 py-2 border-bottom fw-bold">Notifications</li>
                                <ul id="notification-list" class="list-unstyled mb-0">
                                    <li class="notification-empty text-center text-muted py-3" style="font-size:0.85rem;">
                                        <i class="bi bi-bell-slash me-1"></i>No notifications yet
                                    </li>
                                </ul>
                            </ul>
                        </li>
                    {% endif %}
                    
                    {% if app.user %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                {# Profile Picture or Icon #}
                                {% if app.user.userProfile and app.user.userProfile.profilePicture %}
                                    <img src="{{ asset('uploads/profiles/' ~ app.user.userProfile.profilePicture) }}" 
                                        class="rounded-circle me-2" 
                                        style="width: 32px; height: 32px; object-fit: cover;" 
                                        alt="{{ app.user.firstName }}">
                                {% else %}
                                    <i class="bi bi-person-circle me-1" style="font-size: 1.5rem;"></i>
                                {% endif %}
                                {{ app.user.firstName }} {{ app.user.lastName }}
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><a class="dropdown-item" href="{{ path('admin_dashboard') }}">
                                        <i class="bi bi-speedometer2 me-2"></i>Admin Dashboard
                                    </a></li>
                                {% elseif is_granted('ROLE_STAFF') %}
                                    <li><a class="dropdown-item" href="{{ path('staff_dashboard') }}">
                                        <i class="bi bi-speedometer2 me-2"></i>Staff Dashboard
                                    </a></li>
                                {% else %}
                                    <li><a class="dropdown-item" href="{{ path('app_dashboard') }}">
                                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                    </a></li>
                                {% endif %}
                                
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}">
                                    <i class="bi bi-person me-2"></i>My Profile
                                </a></li>

                                {% if not is_granted('ROLE_ADMIN') and not is_granted('ROLE_STAFF') %}
                                    <li><a class="dropdown-item" href="{{ path('user_settings') }}"><i class="bi bi-gear me-2"></i>Settings</a></li>
                                {% endif %}
                                
                                <li><hr class="dropdown-divider"></li>
                                
                                <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </a></li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_login') }}">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light ms-2" href="{{ path('app_register') }}">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1">
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white py-4 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-shop me-2"></i>SMSol Studio
                    </h5>
                    <p class="text-light">Quality clothing and accessories from our studio — premium fashion, delivered to you.</p>
                </div>
                
                <div class="col-md-4">
                    <h5 class="fw-bold mb-3">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="{{ path('app_home') }}" class="text-light text-decoration-none">Home</a></li>
                        <li><a href="{{ path('app_services') }}" class="text-light text-decoration-none">Services</a></li>
                        <li><a href="{{ path('app_about') }}" class="text-light text-decoration-none">About Us</a></li>
                        <li><a href="{{ path('app_contact') }}" class="text-light text-decoration-none">Contact</a></li>
                    </ul>
                </div>
                
                <div class="col-md-4">
                    <h5 class="fw-bold mb-3">Contact Info</h5>
                    <ul class="list-unstyled text-light">
                        <li><i class="bi bi-geo-alt me-2"></i>123 Fashion Street, Style City</li>
                        <li><i class="bi bi-telephone me-2"></i>(123) 456-7890</li>
                        <li><i class="bi bi-envelope me-2"></i>info@smsolstudio.com</li>
                    </ul>
                </div>
            </div>
            
            <hr class="bg-light my-4">
            
            <div class="text-center">
                <p class="mb-0">&copy; {{ "now"|date("Y") }} SMSol Studio. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Add to Cart Modal -->
    {% include 'components/add-to-cart-modal.html.twig' %}

    <!-- Scripts -->
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- jQuery (required for DataTables) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    
    <!-- Custom JS -->
    <script src="{{ asset('js/main.js') }}"></script>
    
    {% block javascripts %}{% endblock %}

    {# ── Socket.io Notifications (Regular User) ── #}
    {% if app.user and not is_granted('ROLE_ADMIN') and not is_granted('ROLE_STAFF') %}
    <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
    <script>
        document.body.dataset.userRole = 'user';

        const socket = io('http://localhost:3001', {
            transports: ['websocket', 'polling'],
            reconnectionAttempts: 5,
        });

        socket.on('connect', () => {
            socket.emit('register', {
                userId: '{{ app.user.id }}',
                role:   'user'
            });

            {# ── Auto-emit new order if just placed ── #}
            {% if app.flashes('new_order_id') is not empty %}
            {% set _oid = app.flashes('new_order_id')|first %}
            {% set _onum = app.flashes('new_order_number')|first %}
            {% set _ototal = app.flashes('new_order_total')|first %}
            socket.emit('order:new', {
                orderId:      '{{ _oid }}',
                orderNumber:  '{{ _onum }}',
                customerName: '{{ app.user.firstName }} {{ app.user.lastName }}',
                totalAmount:  {{ _ototal }}
            });
            {% endif %}
        });

        socket.on('notification', (data) => {
            showSocketNotification(data);
        });

        // ── Expose emitter so checkout page can call it ──
        window.emitNewOrder = function(orderId, orderNumber, customerName, totalAmount) {
            socket.emit('order:new', { orderId, orderNumber, customerName, totalAmount });
        };

        function showSocketNotification(data) {
            let container = document.getElementById('toast-notification-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-notification-container';
                container.style.cssText = 'position:fixed;top:20px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:10px;max-width:360px;';
                document.body.appendChild(container);
            }

            const colorMap = { new_order: '#E91E63', order_status: '#1976D2' };
            const iconMap  = { new_order: '🛒', order_status: '📦' };

            const toast = document.createElement('div');
            toast.style.cssText = `background:#fff;border-left:5px solid ${colorMap[data.type]||'#1976D2'};border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,0.15);padding:14px 18px;display:flex;align-items:flex-start;gap:12px;animation:slideInRight 0.3s ease;cursor:pointer;`;
            toast.innerHTML = `
                <span style="font-size:1.5rem;line-height:1;">${iconMap[data.type]||'🔔'}</span>
                <div style="flex:1;">
                    <div style="font-weight:700;font-size:0.9rem;color:#222;margin-bottom:3px;">${data.title}</div>
                    <div style="font-size:0.82rem;color:#555;">${data.message}</div>
                    <div style="font-size:0.75rem;color:#aaa;margin-top:4px;">${new Date(data.timestamp).toLocaleTimeString()}</div>
                </div>
                <button onclick="this.parentElement.remove()" style="background:none;border:none;font-size:1rem;cursor:pointer;color:#aaa;padding:0;line-height:1;">✕</button>
            `;

            if (data.orderId) {
                toast.addEventListener('click', (e) => {
                    if (e.target.tagName !== 'BUTTON') {
                        window.location.href = '/order/' + data.orderId;
                    }
                });
            }

            container.appendChild(toast);
            incrementBadge();
            addToNotifList(data);
            playBeep();

            setTimeout(() => {
                toast.style.animation = 'fadeOut 0.3s ease forwards';
                setTimeout(() => toast.remove(), 300);
            }, 6000);
        }

        function incrementBadge() {
            const badge = document.getElementById('notification-badge');
            if (badge) {
                const n = (parseInt(badge.textContent) || 0) + 1;
                badge.textContent = n;
                badge.style.display = 'inline-flex';
            }
        }

        function addToNotifList(data) {
            const list = document.getElementById('notification-list');
            if (!list) return;
            const empty = list.querySelector('.notification-empty');
            if (empty) empty.remove();
            const li = document.createElement('li');
            const href = data.orderId ? '/order/' + data.orderId : '#';
            li.innerHTML = `<a class="dropdown-item py-2 px-3 border-bottom" href="${href}">
                <div class="fw-semibold" style="font-size:.85rem;">${data.title}</div>
                <div class="text-muted" style="font-size:.78rem;">${data.message}</div>
                <div class="text-muted" style="font-size:.72rem;">${new Date(data.timestamp).toLocaleTimeString()}</div>
            </a>`;
            list.prepend(li);
        }

        function playBeep() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain); gain.connect(ctx.destination);
                osc.frequency.setValueAtTime(880, ctx.currentTime);
                osc.frequency.setValueAtTime(660, ctx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.3, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
                osc.start(); osc.stop(ctx.currentTime + 0.4);
            } catch(e) {}
        }
    </script>
    <style>
        @keyframes slideInRight { from { transform:translateX(120%); opacity:0; } to { transform:translateX(0); opacity:1; } }
        @keyframes fadeOut { from { opacity:1; } to { opacity:0; transform:translateX(120%); } }
    </style>
    {% endif %}
</body>
<style>
/* === Navbar Styling === */
.navbar {
    background-color: #E91E63 !important; /* Solid Pink background */
}

.navbar .navbar-brand,
.navbar .nav-link {
    color: #ffffff !important; /* White text/icons */
    font-weight: 500;
}

.navbar .nav-link.active {
    border-bottom: 2px solid #ffffff; /* Active item underline */
    font-weight: 600; /* Bold active item */
}

.navbar .btn-teal {
    background-color: #008080; /* Teal button */
    color: #ffffff;
    border-radius: 20px;
    padding: 6px 16px;
    transition: 0.3s;
}

.navbar .btn-teal:hover {
    background-color: #20B2AA; /* Light teal hover */
    color: #ffffff;
}

/* === Sidebar Styling === */
.admin-sidebar {
    background-color: #1E1E1E; /* Dark Gray background */
    color: #ffffff;
    min-width: 240px;
    padding: 1rem;
}

.admin-sidebar .nav-link {
    color: #ffffff;
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    border-left: 4px solid transparent;
    transition: all 0.3s ease;
}

.admin-sidebar .nav-link.active {
    background-color: rgba(233, 30, 99, 0.15); /* Pink background highlight */
    border-left: 4px solid #E91E63;            /* Pink left border */
    color: #E91E63;                            /* Pink text for active */
}

.admin-sidebar .nav-link:hover {
    background-color: rgba(233, 30, 99, 0.1); /* Light pink glow */
    color: #E91E63;
}

.admin-sidebar .nav-link.text-danger {
    color: #E91E63 !important; /* Pink logout text */
}
.admin-sidebar .nav-link.text-danger i {
    color: #E91E63 !important; /* Pink logout icon */
}
</style>
</html>
