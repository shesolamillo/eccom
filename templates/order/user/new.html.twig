{% extends 'base.html.twig' %}
{% block title %}Create New Order{% endblock %}
{% block body %}
<link rel="stylesheet" href="{{ asset('css/cartcheckout.css') }}">

<div class="container py-4">
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_user_orders') }}">Orders</a></li>
            <li class="breadcrumb-item active">New Order</li>
        </ol>
    </nav>
    <h4 class="fw-bold mb-1">Create New Order</h4>
    <p class="text-muted mb-0">Create an order for yourself - step by step</p>
</div>

<input type="hidden" name="_csrf_token" value="{{ csrf_token('order_create') }}">
<input type="hidden" name="customer_id" id="customerId" value="{{ app.user.id }}">

<!-- Progress Steps -->
<div id="orderSteps" class="checkout-steps mb-4">
    <div class="step-item active" id="step1Item">
        <div class="step-circle active"><span class="step-number">1</span><i class="bi bi-check step-check"></i></div>
        <div class="step-label">Cart</div>
    </div>
    <div class="step-connector" id="connector1"></div>
    <div class="step-item" id="step2Item">
        <div class="step-circle"><span class="step-number">2</span><i class="bi bi-check step-check"></i></div>
        <div class="step-label">Address</div>
    </div>
    <div class="step-connector" id="connector2"></div>
    <div class="step-item" id="step3Item">
        <div class="step-circle"><span class="step-number">3</span><i class="bi bi-check step-check"></i></div>
        <div class="step-label">Payment</div>
    </div>
</div>

<div class="row">
<div class="col-lg-8">
<div class="checkout-main" style="position: relative;">

    <!-- Step 1: Cart -->
    <div class="checkout-step active" id="stepCart">
        <h2 class="step-title"><i class="bi bi-cart3 me-2"></i>Shopping Cart</h2>
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Add products to the cart. You're creating an order for {{ app.user.firstName }} {{ app.user.lastName }}.
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Search Products</label>
                <input type="text" id="productSearch" class="form-control" placeholder="Search product name...">
            </div>
            <div class="col-md-6">
                <label class="form-label">Filter by Category</label>
                <select id="categoryFilter" class="form-select">
                    <option value="">All Categories</option>
                    {% for product in products %}
                        {% if product.clothesCategory %}
                            <option value="{{ product.clothesCategory.id }}">{{ product.clothesCategory.name }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="row g-3 mb-4" id="productGrid">
            {% for product in products %}
            <div class="col-md-6" data-category-id="{{ product.clothesCategory ? product.clothesCategory.id : '' }}">
                <div class="card border h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start mb-2">
                            {% if product.photoUrl %}
                                <img src="{{ product.photoUrl }}" alt="{{ product.name }}"
                                     class="rounded me-3" style="width:70px;height:70px;object-fit:cover;">
                            {% else %}
                                <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                                     style="width:70px;height:70px;">
                                    <i class="bi bi-image"></i>
                                </div>
                            {% endif %}
                            <div class="flex-grow-1">
                                <h6 class="mb-1">{{ product.name }}</h6>
                                <p class="text-muted mb-0 small">{{ product.productType.name }}</p>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <strong>₱{{ product.price|number_format(2) }}</strong>
                            {% if product.stock %}
                                <span class="badge bg-info">{{ product.stock.quantity }} stock</span>
                            {% endif %}
                        </div>
                        <div class="input-group input-group-sm">
                            <input type="number" class="form-control product-qty" value="0" min="0"
                                   data-product-id="{{ product.id }}"
                                   data-price="{{ product.price }}">
                            <button class="btn btn-success btn-add-to-cart" type="button"
                                    data-product-id="{{ product.id }}"
                                    data-product-name="{{ product.name }}">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="btn-group-navigation">
            <a href="{{ path('app_user_orders') }}" class="btn btn-secondary">
                <i class="bi bi-x-circle me-2"></i>Cancel
            </a>
            <button class="btn btn-primary" onclick="goToStep(2)">
                Next: Shipping Address <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </div>
    </div>

    <!-- Step 2: Address -->
    <div class="checkout-step" id="stepAddress">
        <h2 class="step-title"><i class="bi bi-geo-alt me-2"></i>Shipping Address</h2>

        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>Your Current Address Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-2"><strong>Name:</strong><br>
                            <span class="text-muted">{{ app.user.firstName }} {{ app.user.lastName }}</span></p>
                        <p class="mb-2"><strong>Phone:</strong><br>
                            <span class="text-muted">{{ app.user.phoneNumber|default('Not set') }}</span></p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-2"><strong>Address:</strong><br>
                            <span class="text-muted">{{ app.user.phoneNumber|default('Not set') }}</span></p>
                        <p class="mb-0"><strong>City:</strong><br>
                            <span class="text-muted">Not set</span></p>
                    </div>
                </div>
            </div>
        </div>

        <form id="addressForm" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Delivery Type <span class="text-danger">*</span></label>
                <select name="delivery_type" id="deliveryType" class="form-select" onchange="updateDeliveryFields()" required>
                    <option value="">-- Select delivery type --</option>
                    <option value="pickup">Pickup</option>
                    <option value="delivery">Delivery</option>
                </select>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch mt-4">
                    <input type="checkbox" name="is_urgent" id="isUrgent" class="form-check-input">
                    <label class="form-check-label" for="isUrgent">
                        <i class="bi bi-lightning me-1"></i>Mark as urgent order
                    </label>
                </div>
            </div>

            <div id="deliveryAddressSection" style="display:none;" class="w-100">
                <h5 class="mb-3 mt-2"><i class="bi bi-house-door me-2"></i>Delivery Address Information</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Recipient Name <span class="text-danger">*</span></label>
                        <input type="text" name="recipient_name" class="form-control" placeholder="Full name of recipient">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone Number <span class="text-danger">*</span></label>
                        <input type="tel" name="phone_number" class="form-control" placeholder="+63 9XX XXX XXXX">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Street Address <span class="text-danger">*</span></label>
                        <input type="text" name="street_address" class="form-control" placeholder="e.g., 123 Main Street">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">City/Municipality <span class="text-danger">*</span></label>
                        <input type="text" name="city" class="form-control" placeholder="City or municipality">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Postal Code <span class="text-danger">*</span></label>
                        <input type="text" name="postal_code" class="form-control" placeholder="e.g., 1234">
                    </div>
                </div>
            </div>

            <div class="col-md-6" id="deliveryFeeSection" style="display:none;">
                <label class="form-label">Delivery Fee (₱)</label>
                <input type="number" name="delivery_fee" class="form-control" step="0.01" min="0" value="100" onchange="updateTotal()">
            </div>
        </form>

        <div class="btn-group-navigation mt-3">
            <button class="btn btn-secondary" onclick="goToStep(1)"><i class="bi bi-arrow-left me-2"></i>Back</button>
            <button class="btn btn-primary" onclick="goToStep(3)">Next: Payment Method <i class="bi bi-arrow-right ms-2"></i></button>
        </div>
    </div>

    <!-- Step 3: Payment -->
    <div class="checkout-step" id="stepPayment">
        <h2 class="step-title"><i class="bi bi-credit-card me-2"></i>Payment Method</h2>

        <div class="col-12">
            <label class="form-label">Choose Payment Method</label>
            <div class="payment-options">
                <div class="form-check mb-3 border rounded p-3">
                    <input class="form-check-input" type="radio" name="payment_method" id="paymentCash" value="cash" required>
                    <label class="form-check-label fw-bold" for="paymentCash">
                        <i class="bi bi-cash-coin me-2 text-success"></i>Cash on Delivery
                    </label>
                    <div class="small text-muted ms-4 mt-1">Pay when you receive the item</div>
                </div>

                <div class="form-check mb-3 border rounded p-3">
                    <input class="form-check-input" type="radio" name="payment_method" id="paymentCard" value="card">
                    <label class="form-check-label fw-bold" for="paymentCard">
                        <i class="bi bi-credit-card me-2 text-primary"></i>Credit/Debit Card
                    </label>
                    <div id="cardDetails" style="display:none;" class="mt-3">
                        <div class="alert alert-warning small mb-3"><i class="bi bi-shield-lock me-1"></i><strong>Demo Mode:</strong> Amount: <strong>₱<span id="paymentAmountCard">0.00</span></strong></div>
                        <div class="row g-3">
                            <div class="col-12"><input type="text" id="cardNumber" class="form-control" placeholder="1234 5678 9012 3456" maxlength="19"></div>
                            <div class="col-md-6"><input type="text" id="cardExpiry" class="form-control" placeholder="MM/YY" maxlength="5"></div>
                            <div class="col-md-6"><input type="password" id="cardCvv" class="form-control" placeholder="123" maxlength="4"></div>
                            <div class="col-12"><input type="text" id="cardholderName" class="form-control" placeholder="Name as shown on card"></div>
                        </div>
                    </div>
                </div>

                <div class="form-check mb-3 border rounded p-3">
                    <input class="form-check-input" type="radio" name="payment_method" id="paymentGcash" value="gcash">
                    <label class="form-check-label fw-bold" for="paymentGcash">
                        <i class="bi bi-cash-stack me-2 text-primary"></i>GCash / PayMaya
                    </label>
                    <div id="gcashDetails" style="display:none;" class="mt-3">
                        <div class="alert alert-warning small mb-3"><i class="bi bi-phone me-1"></i><strong>Demo Mode:</strong> Amount: <strong>₱<span id="paymentAmountGcash">0.00</span></strong></div>
                        <div class="row g-3">
                            <div class="col-12"><input type="text" id="gcashNumber" class="form-control" placeholder="0912 345 6789"></div>
                            <div class="col-12"><input type="text" id="gcashName" class="form-control" placeholder="Full name as registered"></div>
                        </div>
                    </div>
                </div>

                <div class="form-check mb-3 border rounded p-3">
                    <input class="form-check-input" type="radio" name="payment_method" id="paymentTransfer" value="transfer">
                    <label class="form-check-label fw-bold" for="paymentTransfer">
                        <i class="bi bi-bank me-2 text-primary"></i>Bank Transfer
                    </label>
                    <div id="bankDetails" style="display:none;" class="mt-3">
                        <div class="alert alert-warning small mb-3"><i class="bi bi-bank me-1"></i><strong>Demo Mode:</strong> Amount: <strong>₱<span id="paymentAmountTransfer">0.00</span></strong></div>
                        <div class="row g-3">
                            <div class="col-6">
                                <select id="bankName" class="form-select">
                                    <option value="">Select Bank</option>
                                    <option>BDO</option><option>BPI</option>
                                    <option>UnionBank</option><option>Metrobank</option>
                                </select>
                            </div>
                            <div class="col-6"><input type="text" id="bankAccount" class="form-control" placeholder="Your account number"></div>
                            <div class="col-12"><input type="text" id="bankAccountName" class="form-control" placeholder="Account holder name"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-group-navigation mt-3">
            <button class="btn btn-secondary" onclick="goToStep(2)"><i class="bi bi-arrow-left me-2"></i>Back</button>
            <button id="createOrderBtn" class="btn btn-success" onclick="processPayment()" disabled>
                <i class="bi bi-check-circle me-2"></i>Pay & Create Order
            </button>
        </div>

        <!-- Payment Modal -->
        <div class="modal fade" id="paymentModal" tabindex="-1" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center p-5">
                        <div class="spinner-border text-primary mb-3" style="width:3rem;height:3rem;"></div>
                        <h4 id="paymentModalTitle">Processing Payment...</h4>
                        <p id="paymentModalMessage" class="text-muted"></p>
                        <div class="progress mt-3" style="height:5px;">
                            <div id="paymentProgress" class="progress-bar" style="width:0%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Success Modal -->
        <div class="modal fade" id="successModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center p-5">
                        <i class="bi bi-check-circle-fill text-success" style="font-size:4rem;"></i>
                        <h4 class="mt-3">Payment Successful!</h4>
                        <p id="successMessage" class="text-muted"></p>
                        <button class="btn btn-primary mt-3" data-bs-dismiss="modal">Continue</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
</div>

<!-- Sidebar -->
<div class="col-lg-4">
    <div class="card admin-chart sticky-top" style="top:20px;">
        <div class="card-header bg-white border-0">
            <h5 class="mb-0 fw-bold">Order Summary</h5>
            <div class="text-center">
                <small class="text-primary fw-bold" style="font-size:1.50rem;">SMSol Studio</small>
            </div>
        </div>
        <div class="text-center mb-4 pb-2 border-bottom px-3">
            <p class="mb-1 small text-muted">123 Fashion Street, Makati City</p>
            <p class="mb-1 small text-muted">Tel: (02) 1234-5678 | Email: info@smsolstudio.com</p>
            <p class="mb-0 small text-muted">VAT Reg TIN: 123-456-789-000</p>
        </div>
        <div class="card-body">
            <div class="mb-3 pb-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="text-muted">Order No.#:</span>
                <span class="fw-bold text-primary" style="font-family:monospace;">ORD-{{ "now"|date("Ymd") }}-0000</span>
            </div>
            <div class="mb-3 pb-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="text-muted">Customer:</span>
                <span><i class="bi bi-person-circle me-1"></i>{{ app.user.firstName }} {{ app.user.lastName }}</span>
            </div>
            <div class="mb-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small fw-bold">Items</span>
                    <span class="text-muted small fw-bold">Total</span>
                </div>
            </div>
            <div id="cartItems" style="max-height:250px;overflow-y:auto;" class="mb-3">
                <p class="text-muted text-center small">No items added</p>
            </div>
            <div id="deliverySection" style="display:none;" class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted">Delivery Fee</span>
                    <span id="deliveryFee" class="fw-600">₱0.00</span>
                </div>
            </div>
            <div class="mb-2 d-flex justify-content-between align-items-center">
                <span class="text-muted">Subtotal</span>
                <span id="subtotal" class="fw-600">₱0.00</span>
            </div>
            <div class="border-bottom mb-3"></div>
            <div class="d-flex justify-content-between align-items-center">
                <span class="h6 mb-0 fw-bold">TOTAL</span>
                <span class="h4 mb-0 text-primary fw-bold" id="totalAmount">₱0.00</span>
            </div>
        </div>
    </div>
</div>
</div>
</div>

<script>
let cartItems = {};
let paymentModal = null;
let successModal = null;

const deliveryType = document.getElementById('deliveryType');
const deliveryAddressSection = document.getElementById('deliveryAddressSection');
const deliveryFeeSection = document.getElementById('deliveryFeeSection');
const deliveryFeeInput = document.querySelector('input[name="delivery_fee"]');

document.addEventListener('DOMContentLoaded', function() {
    paymentModal = new bootstrap.Modal(document.getElementById('paymentModal'));
    successModal = new bootstrap.Modal(document.getElementById('successModal'));
    updateTotal();
});

function updateDeliveryFields() {
    if (deliveryType.value === 'delivery') {
        deliveryAddressSection.style.display = 'block';
        deliveryFeeSection.style.display = 'block';
        document.getElementById('deliverySection').style.display = 'block';
    } else {
        deliveryAddressSection.style.display = 'none';
        deliveryFeeSection.style.display = 'none';
        document.getElementById('deliverySection').style.display = 'none';
        if (deliveryFeeInput) deliveryFeeInput.value = 0;
    }
    updateTotal();
}

// Product search & filter
document.getElementById('productSearch').addEventListener('input', filterProducts);
document.getElementById('categoryFilter').addEventListener('change', filterProducts);

function filterProducts() {
    const term = document.getElementById('productSearch').value.toLowerCase();
    const cat = document.getElementById('categoryFilter').value;
    document.querySelectorAll('#productGrid .col-md-6').forEach(card => {
        const name = card.querySelector('h6')?.textContent.toLowerCase() || '';
        const cardCat = card.dataset.categoryId || '';
        card.style.display = (!term || name.includes(term)) && (!cat || cardCat === cat) ? '' : 'none';
    });
}

// Add to cart
document.querySelectorAll('.btn-add-to-cart').forEach(btn => {
    btn.addEventListener('click', function() {
        const id = this.dataset.productId;
        const name = this.dataset.productName;
        const qtyInput = document.querySelector(`.product-qty[data-product-id="${id}"]`);
        const qty = parseInt(qtyInput.value) || 0;
        if (qty <= 0) { alert('Please enter a quantity greater than 0'); return; }
        const price = parseFloat(qtyInput.dataset.price);
        cartItems[id] = cartItems[id]
            ? { ...cartItems[id], quantity: cartItems[id].quantity + qty }
            : { name, price, quantity: qty };
        qtyInput.value = 0;
        updateCartDisplay();
    });
});

function updateCartDisplay() {
    const html = Object.entries(cartItems).map(([id, item]) => `
        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="font-size:0.9rem;">
            <div>
                <small class="fw-bold">${item.name}</small><br>
                <small class="text-muted">${item.quantity} × ₱${item.price.toFixed(2)}</small>
            </div>
            <div class="text-end">
                <small class="fw-bold">₱${(item.quantity * item.price).toFixed(2)}</small><br>
                <button class="btn btn-sm btn-outline-danger btn-remove-item" data-product-id="${id}" style="padding:2px 6px;">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>`).join('');
    document.getElementById('cartItems').innerHTML = html || '<p class="text-muted text-center small">No items added</p>';
    document.querySelectorAll('.btn-remove-item').forEach(btn => {
        btn.addEventListener('click', function() {
            delete cartItems[this.dataset.productId];
            updateCartDisplay();
            updateTotal();
        });
    });
    updateTotal();
}

function updateTotal() {
    let subtotal = 0;
    Object.values(cartItems).forEach(item => subtotal += item.quantity * item.price);
    const delivery = deliveryType?.value === 'delivery' ? parseFloat(deliveryFeeInput?.value) || 0 : 0;
    const total = subtotal + delivery;
    document.getElementById('subtotal').textContent = '₱' + subtotal.toFixed(2);
    document.getElementById('deliveryFee').textContent = '₱' + delivery.toFixed(2);
    document.getElementById('totalAmount').textContent = '₱' + total.toFixed(2);
    updatePaymentAmounts();
    updateCreateButtonState();
}

function updatePaymentAmounts() {
    const amount = document.getElementById('totalAmount').textContent.replace('₱', '');
    ['paymentAmountCard','paymentAmountGcash','paymentAmountTransfer'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = amount;
    });
}

function updateCreateButtonState() {
    const btn = document.getElementById('createOrderBtn');
    if (!btn) return;
    const hasItems = Object.keys(cartItems).length > 0;
    const paymentSelected = document.querySelector('input[name="payment_method"]:checked') !== null;
    btn.disabled = !(hasItems && paymentSelected);
}

// Payment method toggle
document.querySelectorAll('input[name="payment_method"]').forEach(radio => {
    radio.addEventListener('change', function() {
        ['cardDetails','gcashDetails','bankDetails'].forEach(id => document.getElementById(id).style.display = 'none');
        if (this.value === 'card') document.getElementById('cardDetails').style.display = 'block';
        if (this.value === 'gcash') document.getElementById('gcashDetails').style.display = 'block';
        if (this.value === 'transfer') document.getElementById('bankDetails').style.display = 'block';
        updateCreateButtonState();
    });
});

// Auto-format
document.getElementById('cardNumber')?.addEventListener('input', function(e) {
    let v = e.target.value.replace(/\s/g, '').slice(0, 16);
    e.target.value = v.replace(/(\d{4})/g, '$1 ').trim();
});
document.getElementById('cardExpiry')?.addEventListener('input', function(e) {
    let v = e.target.value.replace(/\D/g, '');
    if (v.length >= 2) v = v.slice(0,2) + '/' + v.slice(2,4);
    e.target.value = v;
});

function goToStep(step) {
    document.querySelectorAll('.checkout-step').forEach(el => el.classList.remove('active'));
    for (let i = 1; i <= 3; i++) {
        const item = document.getElementById(`step${i}Item`);
        const connector = document.getElementById(`connector${i}`);
        item.classList.remove('active', 'completed');
        if (connector) connector.classList.remove('active', 'completed');
        if (i < step) { item.classList.add('completed'); if (connector) connector.classList.add('completed'); }
        else if (i === step) item.classList.add('active');
    }
    const map = {1:'stepCart', 2:'stepAddress', 3:'stepPayment'};
    document.getElementById(map[step]).classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

async function processPayment() {
    const paymentMethod = document.querySelector('input[name="payment_method"]:checked');
    if (!paymentMethod) { alert('Please select a payment method'); return; }
    if (Object.keys(cartItems).length === 0) { alert('Please add at least one product'); goToStep(1); return; }
    if (!deliveryType.value) { alert('Please select a delivery type'); goToStep(2); return; }

    const total = parseFloat(document.getElementById('totalAmount').textContent.replace('₱', ''));
    switch(paymentMethod.value) {
        case 'cash': await createOrder('pending', 'cash'); break;
        case 'card': await simulateCardPayment(total); break;
        case 'gcash': await simulateGCashPayment(total); break;
        case 'transfer': await simulateBankTransfer(total); break;
    }
}

async function simulateCardPayment(amount) {
    const cardNumber = document.getElementById('cardNumber')?.value;
    const cardExpiry = document.getElementById('cardExpiry')?.value;
    const cardCvv = document.getElementById('cardCvv')?.value;
    const cardholderName = document.getElementById('cardholderName')?.value;
    if (!cardNumber || !cardExpiry || !cardCvv || !cardholderName) { alert('Please fill in all card details'); return; }
    const clean = cardNumber.replace(/\s/g, '');
    if (clean.length !== 16) { alert('Please enter a valid 16-digit card number'); return; }
    if (!cardExpiry.match(/^(0[1-9]|1[0-2])\/\d{2}$/)) { alert('Please enter valid expiry date (MM/YY)'); return; }
    if (cardCvv.length < 3) { alert('Please enter valid CVV'); return; }
    showPaymentModal('Processing Card Payment...', 'Please wait while we verify your card details.');
    await simulateProgress();
    paymentModal.hide();
    showSuccessModal(`Payment of ₱${amount.toFixed(2)} successfully charged to card ending in ${clean.slice(-4)}.`);
    await createOrder('paid', 'card');
}

async function simulateGCashPayment(amount) {
    const gcashNumber = document.getElementById('gcashNumber')?.value;
    const gcashName = document.getElementById('gcashName')?.value;
    if (!gcashNumber || !gcashName) { alert('Please fill in GCash/Maya number and account name'); return; }
    const clean = gcashNumber.replace(/\s/g, '');
    if (!clean.match(/^09\d{9}$/)) { alert('Please enter a valid Philippine mobile number (e.g., 09123456789)'); return; }
    showPaymentModal('Processing GCash Payment...', `Sending payment request to ${clean}.`);
    await simulateProgress();
    paymentModal.hide();
    showSuccessModal(`₱${amount.toFixed(2)} deducted from GCash (${clean}). Ref: GCASH-${Date.now()}`);
    await createOrder('paid', 'gcash');
}

async function simulateBankTransfer(amount) {
    const bankName = document.getElementById('bankName')?.value;
    const bankAccount = document.getElementById('bankAccount')?.value;
    const bankAccountName = document.getElementById('bankAccountName')?.value;
    if (!bankName || !bankAccount || !bankAccountName) { alert('Please fill in all bank transfer details'); return; }
    showPaymentModal('Processing Bank Transfer...', `Transferring ₱${amount.toFixed(2)} from ${bankName}.`);
    await simulateProgress();
    paymentModal.hide();
    showSuccessModal(`₱${amount.toFixed(2)} transferred from ${bankName} (${bankAccount}). Ref: TRANSFER-${Date.now()}`);
    await createOrder('paid', 'transfer');
}

async function simulateProgress() {
    let progress = 0;
    return new Promise(resolve => {
        const interval = setInterval(() => {
            progress += 10;
            document.getElementById('paymentProgress').style.width = progress + '%';
            if (progress >= 100) { clearInterval(interval); setTimeout(resolve, 500); }
        }, 300);
    });
}

function showPaymentModal(title, message) {
    document.getElementById('paymentModalTitle').textContent = title;
    document.getElementById('paymentModalMessage').textContent = message;
    document.getElementById('paymentProgress').style.width = '0%';
    paymentModal.show();
}

function showSuccessModal(message) {
    document.getElementById('successMessage').textContent = message;
    successModal.show();
}

async function createOrder(paymentStatus, paymentType) {
    const selectedPayment = document.querySelector('input[name="payment_method"]:checked');
    const formData = new FormData();
    formData.append('customer_id', document.getElementById('customerId').value);
    formData.append('delivery_type', deliveryType.value);
    formData.append('payment_method', selectedPayment.value);
    formData.append('payment_status', paymentStatus);
    formData.append('is_urgent', document.getElementById('isUrgent').checked ? 1 : 0);
    formData.append('_csrf_token', document.querySelector('input[name="_csrf_token"]').value);

    if (deliveryType.value === 'delivery') {
        formData.append('recipient_name', document.querySelector('input[name="recipient_name"]').value);
        formData.append('phone_number', document.querySelector('input[name="phone_number"]').value);
        formData.append('street_address', document.querySelector('input[name="street_address"]').value);
        formData.append('city', document.querySelector('input[name="city"]').value);
        formData.append('postal_code', document.querySelector('input[name="postal_code"]').value);
        formData.append('delivery_fee', deliveryFeeInput?.value || 0);
    } else {
        formData.append('delivery_fee', 0);
    }

    let itemCount = 0;
    Object.entries(cartItems).forEach(([id, item]) => {
        formData.append(`items[${itemCount}][product_id]`, id);
        formData.append(`items[${itemCount}][quantity]`, item.quantity);
        itemCount++;
    });

    try {
        const response = await fetch('{{ path("app_user_order_create") }}', {
            method: 'POST',
            body: formData,
            credentials: 'same-origin'
        });
        if (response.ok) {
            setTimeout(() => { window.location.href = '{{ path("app_user_orders") }}'; }, 2000);
        } else {
            const text = await response.text();
            alert('Error creating order: ' + text);
        }
    } catch (error) {
        alert('Error creating order: ' + error.message);
    }
}
</script>
{% endblock %}

