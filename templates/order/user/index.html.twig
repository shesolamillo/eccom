{% extends 'base.html.twig' %}

{% block title %}My Purchases{% endblock %}

{% block body %}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

    <h2 class="mb-4">🛍️ My Purchases</h2>

    {% if orders is empty %}
        <div class="alert alert-info">
            Wala kay purchases yet.
        </div>
    {% endif %}

    <div class="row">

        {% for order in orders %}
            <div class="col-md-6 mb-4">

                <div class="card shadow-sm">

                    <!-- HEADER -->
                    <div class="card-header d-flex justify-content-between">
                        <strong>Order #{{ order.id }}</strong>

                        {% if order.status == 'pending' %}
                            <span class="badge bg-warning text-dark">Pending</span>
                        {% elseif order.status == 'shipped' %}
                            <span class="badge bg-info">Shipped</span>
                        {% elseif order.status == 'delivered' %}
                            <span class="badge bg-success">Delivered</span>
                        {% else %}
                            <span class="badge bg-secondary">Unknown</span>
                        {% endif %}
                    </div>

                    <!-- BODY -->
                    <div class="card-body">

                        <p><strong>Total:</strong> ₱ {{ order.totalAmount }}</p>

                        <p class="mb-2"><strong>Items:</strong></p>

                        <!-- PRODUCTS INSIDE ORDER -->
                        {% if order.items is defined and order.items is not empty %}
                            <ul class="list-group">
                                {% for item in order.items %}
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>{{ item.product.name }}</span>
                                        <span>x{{ item.quantity }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <small class="text-muted">No items found</small>
                        {% endif %}

                    </div>

                </div>

            </div>
        {% endfor %}

    </div>

</div>

{% endblock %}