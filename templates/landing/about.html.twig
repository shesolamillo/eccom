{# templates/landing/about.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}About Us - SMSol Studio{% endblock %}

{% block stylesheets %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Pacifico&display=swap');

  body {
    background: url("{{ asset('uploads/images/serviceBG.png') }}") center top / cover no-repeat;
    min-height: 100vh;
    position: relative;
  }

  body::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(50, 3, 18, 0.80);
    z-index: 0;
  }

  section {
    position: relative;
    z-index: 1;
    background: transparent !important;
  }

  .font-fancy { font-family: 'Pacifico', cursive; font-weight: 400 !important; }
  .text-pink  { color: #ff1a6e; }
  h1, h2, h3, h4, h5 { color: #fff; }
  p { color: #ccc; }

  /* ── Hero ── */
  .hero-section { padding: 5rem 0 3rem; text-align: center; }

  /* ── Glow cards ── */
  .glow-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1.5px solid #ff1a6e55;
    border-radius: 20px;
    box-shadow: 0 0 20px #ff1a6e22, inset 0 0 30px rgba(255,26,110,0.05);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .glow-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 40px #ff1a6e55, inset 0 0 30px rgba(255,26,110,0.08);
  }

  /* ── Story section ── */
  .story-img {
    border-radius: 16px;
    border: 2px solid #ff1a6e55;
    box-shadow: 0 0 30px #ff1a6e33;
    width: 100%;
    height: 280px;
    object-fit: cover;
  }

  .story-placeholder {
    background: linear-gradient(135deg, #2a0a18, #1a0008);
    border-radius: 16px;
    border: 2px solid #ff1a6e55;
    box-shadow: 0 0 30px #ff1a6e33;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Icon circles ── */
  .icon-glow {
    width: 65px; height: 65px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem;
    margin: 0 auto 1rem;
    box-shadow: 0 0 20px currentColor;
  }

  /* ── Stats ── */
  .stat-box {
    background: rgba(255,26,110,0.08);
    border: 1px solid #ff1a6e44;
    border-radius: 16px;
    padding: 2rem 1rem;
    text-align: center;
    transition: transform 0.3s;
  }

  .stat-box:hover { transform: translateY(-4px); }
  .stat-number { font-family: 'Pacifico', cursive; color: #ff1a6e; font-size: 2.8rem; line-height: 1; }
  .stat-label  { color: #aaa; font-size: 0.875rem; margin-top: 0.4rem; }

  /* ── Team ── */
  .team-img {
    width: 110px; height: 110px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid #ff1a6e;
    box-shadow: 0 0 20px #ff1a6e55;
  }

  .team-role { color: #ff1a6e; font-size: 0.85rem; }

  /* ── CTA ── */
  .cta-wrap {
    background: linear-gradient(135deg, rgba(255,26,110,0.12), rgba(204,0,85,0.08));
    border: 1.5px solid #ff1a6e44;
    border-radius: 24px;
    padding: 4rem 2rem;
    text-align: center;
    box-shadow: 0 0 40px #ff1a6e22;
  }

  /* ── Buttons ── */
  .btn-pink {
    background: linear-gradient(135deg, #ff1a6e, #cc0055);
    border: none; border-radius: 50px;
    color: #fff; font-weight: 600; padding: 0.75rem 2rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-pink:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,26,110,0.5);
    color: #fff;
  }

  .btn-outline-pink {
    border: 1.5px solid #ff1a6e; border-radius: 50px;
    color: #ff1a6e; background: transparent;
    font-weight: 600; padding: 0.75rem 2rem;
    transition: all 0.2s;
  }

  .btn-outline-pink:hover { background: #ff1a6e; color: #fff; }

  .pink-divider { border: none; border-top: 1px solid #ff1a6e18; margin: 0; }
</style>
{% endblock %}

{% block body %}

<!-- Hero -->
<section class="hero-section">
  <div class="container">
    <div class="col-lg-7 mx-auto">
      <h1 class="font-fancy display-4 mb-3">About SMSol Studio</h1>
      <p class="lead" style="color:#ddd;">Premium clothing services designed for your convenience</p>
    </div>
  </div>
</section>

<hr class="pink-divider">

<!-- Our Story -->
<section class="py-5">
  <div class="container">
    <div class="glow-card p-4 p-md-5">
      <div class="row align-items-center g-4">
        <div class="col-lg-7">
          <h2 class="font-fancy mb-4">Our <span class="text-pink">Story</span></h2>
          <p class="lead mb-3" style="color:#ddd;">Founded in 2020, SMSol Studio began with a simple vision — to provide premium fashion that combines quality, style, and convenience in one place.</p>
          <p class="mb-3">What started as a small boutique has grown into a trusted fashion destination, serving thousands of satisfied customers nationwide. We believe everyone deserves access to quality clothing.</p>
          <p class="mb-4">Our journey is built on three pillars: <span class="text-pink fw-bold">Quality</span>, <span class="text-pink fw-bold">Style</span>, <span class="text-pink fw-bold">Customer Satisfaction</span>.</p>
          <div class="d-flex align-items-start gap-3 p-3" style="background:rgba(255,26,110,0.08); border-radius:12px; border:1px solid #ff1a6e33;">
            <i class="bi bi-award text-pink fs-4 mt-1"></i>
            <div>
              <p class="mb-1" style="color:#ddd;">We never compromise on quality.</p>
              <p class="mb-0" style="font-size:0.875rem;">Every product is carefully selected and inspected to meet our high standards.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="story-placeholder">
            <div class="text-center">
              <i class="bi bi-person-hearts text-pink" style="font-size:5rem; opacity:0.8;"></i>
              <p class="text-pink mt-2 mb-0" style="font-family:'Pacifico',cursive;">SMSol Studio</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<hr class="pink-divider">

<!-- Mission & Vision -->
<section class="py-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-6">
        <div class="glow-card p-4 p-md-5 h-100">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="icon-glow" style="background:rgba(13,110,253,0.15); color:#0d6efd;">
              <i class="bi bi-bullseye"></i>
            </div>
            <h3 class="font-fancy mb-0">Our Mission</h3>
          </div>
          <p>To provide premium fashion solutions that empower individuals to express their unique style with confidence and comfort.</p>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="glow-card p-4 p-md-5 h-100">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="icon-glow" style="background:rgba(255,26,110,0.15); color:#ff1a6e;">
              <i class="bi bi-eye"></i>
            </div>
            <h3 class="font-fancy mb-0">Our Vision</h3>
          </div>
          <p>To become the leading fashion destination known for exceptional quality, curated style, and unparalleled customer experience.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<hr class="pink-divider">

<!-- Values -->
<section class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="font-fancy">Our Values</h2>
      <p style="color:#aaa;">The principles that guide everything we do</p>
    </div>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="glow-card p-4 h-100 text-center">
          <div class="icon-glow mx-auto" style="background:rgba(255,26,110,0.15); color:#ff1a6e;">
            <i class="bi bi-award"></i>
          </div>
          <h4>Quality First</h4>
          <p>We never compromise on quality. Every product is carefully selected and inspected to meet our high standards.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="glow-card p-4 h-100 text-center">
          <div class="icon-glow mx-auto" style="background:rgba(255,26,110,0.15); color:#ff1a6e;">
            <i class="bi bi-heart"></i>
          </div>
          <h4>Customer Focus</h4>
          <p>Your satisfaction is our priority. We listen to feedback and continuously improve our services.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="glow-card p-4 h-100 text-center">
          <div class="icon-glow mx-auto" style="background:rgba(255,193,7,0.15); color:#ffc107;">
            <i class="bi bi-lightbulb"></i>
          </div>
          <h4>Innovation</h4>
          <p>We embrace change and innovation to bring you the latest fashion trends and convenient shopping experiences.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<hr class="pink-divider">

<!-- Stats -->
<section class="py-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-6 col-md-3">
        <div class="stat-box">
          <div class="stat-number">4+</div>
          <div class="stat-label">Years Experience</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-box">
          <div class="stat-number">2K+</div>
          <div class="stat-label">Happy Customers</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-box">
          <div class="stat-number">500+</div>
          <div class="stat-label">Products</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-box">
          <div class="stat-number">50+</div>
          <div class="stat-label">Brand Partners</div>
        </div>
      </div>
    </div>
  </div>
</section>

<hr class="pink-divider">

<!-- Team -->
<section class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="font-fancy">Meet Our Team</h2>
      <p style="color:#aaa;">The talented people behind SMSol Studio</p>
    </div>

    <div class="row g-3 justify-content-center">
        <div class="col-6 col-md">
            <div class="glow-card p-4 text-center h-100">
                <img src="{{ asset('uploads/images/Me.jpg') }}" alt="Sheila Mae Solamillo" class="team-img mb-3">
                <h4 class="mb-1">Sheila Mae Solamillo</h4>
                <p class="team-role mb-2">Founder & CEO</p>
                <p class="small">With over 10 years in fashion retail, Sheila leads our vision and strategy.</p>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="glow-card p-4 text-center h-100">
                <img src="{{ asset('uploads/images/Luds.jpg') }}" alt="Ludilyn Quibot" class="team-img mb-3">
                <h4 class="mb-1">Ludilyn Quibot</h4>
                <p class="team-role mb-2">Head of Operations</p>
                <p class="small">Ludilyn ensures smooth operations and excellent customer service.</p>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="glow-card p-4 text-center h-100">
                <img src="{{ asset('uploads/images/jov.jpg') }}" alt="Jovelyn Del Rosario" class="team-img mb-3">
                <h4 class="mb-1">Jovelyn A. Del Rosario</h4>
                <p class="team-role mb-2">Fashion Director</p>
                <p class="small">Jovelyn curates our collection with an eye for style and quality.</p>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="glow-card p-4 text-center h-100">
                <img src="{{ asset('uploads/images/precille.jpg') }}" alt="Precille G Amorganda" class="team-img mb-3">
                <h4 class="mb-1">Precille G Amorganda</h4>
                <p class="team-role mb-2">Creative Director</p>
                <p class="small">Precille leads brand identity, campaigns, and creative direction.</p>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="glow-card p-4 text-center h-100">
                <img src="{{ asset('uploads/images/jink.jpg') }}" alt="Jingky Grancapal" class="team-img mb-3">
                <h4 class="mb-1">Jingky Grancapal</h4>
                <p class="team-role mb-2">Product Development Manager</p>
                <p class="small">Jingky leads product innovation, supplier partnerships, and quality control.</p>
            </div>
        </div>
    </div>



   


  </div>
</section>

<hr class="pink-divider">

<!-- CTA -->
<section class="py-5">
  <div class="container">
    <div class="cta-wrap">
      <h2 class="font-fancy mb-3">Ready to Experience Quality Fashion?</h2>
      <p style="color:#aaa;" class="mb-4">Join our community of fashion enthusiasts today.</p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="{{ path('app_register') }}" class="btn btn-pink btn-lg">
          <i class="bi bi-person-plus me-2"></i>Join Now
        </a>
        <a href="{{ path('app_contact') }}" class="btn btn-outline-pink btn-lg">
          <i class="bi bi-chat-dots me-2"></i>Contact Us
        </a>
      </div>
    </div>
  </div>
</section>

{% endblock %}
