{# templates/landing/services.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Our Services - SMSol Studio{% endblock %}



{% block stylesheets %}
 <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
 <style>
  body {
    background: url("{{ asset('uploads/images/serviceBG.png') }}") center center / cover no-repeat;
    min-height: 100vh;
    position: relative;
  }

  body::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(60, 5, 20, 0.66);
    z-index: 0;
  }

  section {
    position: relative;
    z-index: 1;
    background: transparent !important;
  }

  .hero-section { padding: 5rem 0 3rem; }

  .service-card {
    background: linear-gradient(145deg, #1c1c1c, #111) !important;
    border: 1.5px solid #ff1a6e44 !important;
    border-radius: 16px;
    color: #fff;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 30px #ff1a6e55;
  }

  .service-card .card-text { color: #aaa; font-size: 0.875rem; }
  .service-card ul li      { color: #ccc; font-size: 0.875rem; margin-bottom: 0.4rem; }

  .icon-wrapper {
    width: 60px; height: 60px;
    display: flex; align-items: center; justify-content: center;
  }

  .extra-card {
    background: linear-gradient(145deg, #1c1c1c, #111) !important;
    border: 1.5px solid #ff1a6e33 !important;
    border-radius: 16px;
    color: #fff;
  }

  .extra-card .text-muted { color: #aaa !important; }
  .extra-card small       { color: #888 !important; }

  .pricing-card {
    background: linear-gradient(145deg, #1c1c1c, #111) !important;
    border: 1.5px solid #333 !important;
    border-radius: 16px;
    color: #fff;
    transition: transform 0.3s;
  }

  .pricing-card:hover { transform: translateY(-5px); }

  .pricing-card .card-header {
    border-radius: 14px 14px 0 0 !important;
    padding: 1.25rem;
    border: none;
  }

  .pricing-card ul li { color: #ccc; font-size: 0.875rem; margin-bottom: 0.5rem; }

  .pricing-card.premium {
    border-color: #ff1a6e !important;
    box-shadow: 0 0 30px #ff1a6e44;
    transform: scale(1.03);
  }

  .pricing-card.premium:hover { transform: scale(1.03) translateY(-5px); }

  .btn-pricing-pink {
    background: linear-gradient(135deg, #ff1a6e, #cc0055);
    border: none;
    border-radius: 50px;
    color: #fff;
    font-weight: 600;
    transition: transform 0.2s;
  }

  .btn-pricing-pink:hover { transform: translateY(-2px); color: #fff; }

  .btn-pricing-outline {
    border: 1.5px solid #ff1a6e;
    border-radius: 50px;
    color: #ff1a6e;
    background: transparent;
    font-weight: 600;
    transition: all 0.2s;
  }

  .btn-pricing-outline:hover { background: #ff1a6e; color: #fff; }

  .testimonial-card {
    background: linear-gradient(145deg, #1c1c1c, #111) !important;
    border: 1.5px solid #ff1a6e33 !important;
    border-radius: 16px;
    color: #fff;
  }

  .testimonial-card p           { color: #ccc; font-size: 0.9rem; }
  .testimonial-card .text-muted { color: #888 !important; }

  .text-pink { color: #ff1a6e; }


 
.pricing-title {
  font-family: 'Bilderberg', cursive;
  font-weight: 400 !important;
}
</style>
{% endblock %}

{% block body %}

<!-- Hero -->
<section class="hero-section">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 mx-auto text-center">
        <h1 class="fw-bold text-white mb-3">Our Services</h1>
        <p class="lead text-white mb-0">Premium clothing services designed for your lifestyle</p>
      </div>
    </div>
  </div>
</section>

<!-- Service Cards -->
<section class="py-5">
  <div class="container">
    <div class="row">

      <div class="col-lg-4 mb-4">
        <div class="card service-card h-100">
          <div class="card-body text-center p-4">
            <div class="icon-wrapper bg-primary rounded-circle p-3 mb-3 mx-auto">
              <i class="bi bi-tshirt text-white fs-3"></i>
            </div>
            <h4 class="card-title text-white">Premium Clothing</h4>
            <p class="card-text">Curated collection of high-quality clothing and accessories from top brands. From casual wear to formal attire.</p>
            <ul class="list-unstyled text-start mt-3">
              <li><i class="bi bi-check-circle text-pink me-2"></i>Quality fabrics</li>
              <li><i class="bi bi-check-circle text-pink me-2"></i>Latest fashion trends</li>
              <li><i class="bi bi-check-circle text-pink me-2"></i>Size customization</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="col-lg-4 mb-4">
        <div class="card service-card h-100">
          <div class="card-body text-center p-4">
            <div class="icon-wrapper bg-success rounded-circle p-3 mb-3 mx-auto">
              <i class="bi bi-truck text-white fs-3"></i>
            </div>
            <h4 class="card-title text-white">Fast Delivery</h4>
            <p class="card-text">Quick and reliable delivery services to your doorstep. Same-day delivery available in select areas.</p>
            <ul class="list-unstyled text-start mt-3">
              <li><i class="bi bi-check-circle text-pink me-2"></i>Same-day delivery</li>
              <li><i class="bi bi-check-circle text-pink me-2"></i>Free shipping with min ₱1000</li>
              <li><i class="bi bi-check-circle text-pink me-2"></i>Real-time tracking</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="col-lg-4 mb-4">
        <div class="card service-card h-100">
          <div class="card-body text-center p-4">
            <div class="icon-wrapper bg-warning rounded-circle p-3 mb-3 mx-auto">
              <i class="bi bi-star text-white fs-3"></i>
            </div>
            <h4 class="card-title text-white">Quality Assurance</h4>
            <p class="card-text">Every item is carefully inspected for quality and perfection. We stand behind every product we sell.</p>
            <ul class="list-unstyled text-start mt-3">
              <li><i class="bi bi-check-circle text-pink me-2"></i>30-day return policy</li>
              <li><i class="bi bi-check-circle text-pink me-2"></i>Quality inspection</li>
              <li><i class="bi bi-check-circle text-pink me-2"></i>Warranty on select items</li>
            </ul>
          </div>
        </div>
      </div>

    </div>

    <!-- Additional Services -->
    <div class="row mt-2">
      <div class="col-md-6 mb-4">
        <div class="card extra-card h-100">
          <div class="card-body p-4">
            <h4 class="text-white mb-2">Personal Styling</h4>
            <p class="text-muted">Get personalized fashion advice from our expert stylists. We help you create outfits that match your style and occasion.</p>
            <div class="d-flex align-items-center mt-3">
              <i class="bi bi-person-check fs-4 text-pink me-3"></i>
              <div>
                <h6 class="mb-0 text-white">Professional Stylists</h6>
                <small>Certified fashion experts</small>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6 mb-4">
        <div class="card extra-card h-100">
          <div class="card-body p-4">
            <h4 class="text-white mb-2">Gift Services</h4>
            <p class="text-muted">Perfect gift solutions for any occasion. We offer gift wrapping, personalized messages, and gift cards.</p>
            <div class="d-flex align-items-center mt-3">
              <i class="bi bi-gift fs-4 text-pink me-3"></i>
              <div>
                <h6 class="mb-0 text-white">Gift Packaging</h6>
                <small>Elegant gift wrapping</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Pricing -->
