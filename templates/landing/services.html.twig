            </ul>
            <a href="{{ path('app_register') }}" class="btn btn-pricing-pink w-100">🐾 Get Started</a>
          </div>
        </div>
      </div>

      <div class="col-md-4 mb-4">
        <div class="card pricing-card text-center h-100">
          <div class="card-header" style="background: linear-gradient(135deg, #1a1a1a, #333);">
