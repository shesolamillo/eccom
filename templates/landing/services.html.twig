              <li class="mb-2"><i class="bi bi-check text-pink me-2"></i>Same-day delivery</li>
              <li class="mb-2"><i class="bi bi-check text-pink me-2"></i>24/7 support</li>
              <li class="mb-2"><i class="bi bi-check text-pink me-2"></i>Bulk ordering</li>
              <li class="mb-2"><i class="bi bi-check text-pink me-2"></i>Custom solutions</li>
            </ul>
            <a href="{{ path('app_contact') }}" class="btn btn-pricing-outline w-100">Contact Sales</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- CTA -->
