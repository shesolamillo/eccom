{# templates/landing/contact.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Contact Us - SMSol Studio{% endblock %}

{% block stylesheets %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Pacifico&display=swap');

  body {
    background: url("{{ asset('uploads/images/serviceBG.png') }}") center top / cover no-repeat;
    min-height: 100vh;
    position: relative;
  }

  body::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(50, 3, 18, 0.80);
    z-index: 0;
  }

  section {
    position: relative;
    z-index: 1;
    background: transparent !important;
  }

  .font-fancy { font-family: 'Pacifico', cursive; font-weight: 400 !important; }
  .text-pink  { color: #ff1a6e; }
  h1, h2, h3, h4, h5, h6 { color: #fff; }
  p, label { color: #ccc; }

  /* ── Hero ── */
  .hero-section { padding: 5rem 0 3rem; text-align: center; }

  /* ── Glow card ── */
  .glow-card {
    background: rgba(255,255,255,0.04);
    border: 1.5px solid #ff1a6e44;
    border-radius: 20px;
    box-shadow: 0 0 20px #ff1a6e22;
  }

  /* ── Form inputs ── */
  .form-control, .form-select {
    background: #1e1e1e !important;
    border: 1px solid #333 !important;
    color: #fff !important;
    border-radius: 10px !important;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .form-control:focus, .form-select:focus {
    border-color: #ff1a6e !important;
    box-shadow: 0 0 0 0.2rem rgba(255,26,110,0.25) !important;
    background: #1e1e1e !important;
    color: #fff !important;
  }

  .form-control::placeholder { color: #555 !important; }

  .form-select option { background: #1e1e1e; color: #fff; }

  /* ── Submit button ── */
  .btn-pink {
    background: linear-gradient(135deg, #ff1a6e, #cc0055);
    border: none; border-radius: 50px;
    color: #fff; font-weight: 600;
    padding: 0.75rem 2rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-pink:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,26,110,0.5);
    color: #fff;
  }

  /* ── Contact info icons ── */
  .contact-icon {
    width: 45px; height: 45px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    font-size: 1.1rem;
  }

  .contact-info-text h6 { color: #fff; margin-bottom: 0.25rem; }
  .contact-info-text p  { color: #aaa; font-size: 0.875rem; margin: 0; }

  /* ── Social icons ── */
  .social-icon {
    width: 48px; height: 48px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    font-size: 1.2rem;
    text-decoration: none;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .social-icon:hover { transform: translateY(-4px); color: #fff; }
  .social-icon.facebook  { background: #3b5998; }
  .social-icon.instagram { background: linear-gradient(135deg, #e4405f, #ff6b35); }
  .social-icon.twitter   { background: #1da1f2; }
  .social-icon.linkedin  { background: #0077b5; }

  /* ── Map ── */
  .map-container {
    border-radius: 16px;
    overflow: hidden;
    border: 1.5px solid #ff1a6e33;
    box-shadow: 0 0 20px #ff1a6e22;
  }

  /* ── FAQ accordion ── */
  .accordion-item {
    background: rgba(255,255,255,0.04) !important;
    border: 1px solid #ff1a6e33 !important;
    border-radius: 12px !important;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  .accordion-button {
    background: rgba(255,255,255,0.04) !important;
    color: #fff !important;
    font-weight: 500;
    border-radius: 12px !important;
  }

  .accordion-button:not(.collapsed) {
    background: rgba(255,26,110,0.12) !important;
    color: #ff1a6e !important;
    box-shadow: none !important;
  }

  .accordion-button::after {
    filter: invert(1);
  }

  .accordion-body {
    background: rgba(255,255,255,0.02) !important;
    color: #ccc;
    border-top: 1px solid #ff1a6e22;
  }

  /* ── Alert ── */
  .alert-success {
    background: #0a2a0a !important;
    border-color: #1aff6e44 !important;
    color: #66ff99 !important;
  }

  .alert-danger {
    background: #2a0010 !important;
    border-color: #ff1a6e44 !important;
    color: #ff6699 !important;
  }

  .pink-divider { border: none; border-top: 1px solid #ff1a6e18; margin: 0; }
</style>
{% endblock %}

{% block body %}

<!-- Hero -->
<section class="hero-section">
  <div class="container">
    <div class="col-lg-7 mx-auto">
      <h1 class="font-fancy display-4 mb-3">Contact Us</h1>
      <p class="lead" style="color:#ddd;">We're here to help. Get in touch with our team.</p>
    </div>
  </div>
</section>

<hr class="pink-divider">

<!-- Contact Section -->
<section class="py-5">
  <div class="container">
    <div class="row g-4">

      <!-- Form -->
      <div class="col-lg-8">
        <div class="glow-card p-4 p-md-5">
          <h3 class="font-fancy mb-4">Send us a <span class="text-pink">Message</span></h3>

          {% for message in app.flashes('contact_success') %}
          <div class="alert alert-success alert-dismissible fade show py-2">
            <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
          </div>
          {% endfor %}

          {% for message in app.flashes('contact_error') %}
          <div class="alert alert-danger alert-dismissible fade show py-2">
            {{ message }}
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
          </div>
          {% endfor %}

          <form method="post" action="{{ path('app_contact_submit') }}" id="contactForm">
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label small">First Name *</label>
                <input type="text" class="form-control" name="firstName" placeholder="Enter first name" required>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label small">Last Name *</label>
                <input type="text" class="form-control" name="lastName" placeholder="Enter last name" required>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label small">Email Address *</label>
              <input type="email" class="form-control" name="email" placeholder="Enter email address" required>
            </div>

            <div class="mb-3">
              <label class="form-label small">Phone Number</label>
              <input type="tel" class="form-control" name="phone" placeholder="Enter phone number">
            </div>

            <div class="mb-3">
              <label class="form-label small">Subject *</label>
              <select class="form-select" name="subject" required>
                <option value="">Select a subject</option>
                <option value="general">General Inquiry</option>
                <option value="order">Order Support</option>
                <option value="product">Product Information</option>
                <option value="return">Returns & Exchanges</option>
                <option value="partnership">Business Partnership</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="mb-4">
              <label class="form-label small">Message *</label>
              <textarea class="form-control" name="message" rows="5" placeholder="Write your message here..." required></textarea>
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-pink btn-lg">
                <i class="bi bi-send me-2"></i>Send Message
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="col-lg-4">
        <div class="glow-card p-4 mb-4">
          <h5 class="font-fancy mb-4">Contact <span class="text-pink">Info</span></h5>

          <div class="d-flex align-items-start gap-3 mb-4">
            <div class="contact-icon" style="background:rgba(13,110,253,0.2); color:#0d6efd;">
              <i class="bi bi-geo-alt-fill"></i>
            </div>
            <div class="contact-info-text">
              <h6>Our Location</h6>
              <p>123 Fashion Street<br>Style City, SC 12345<br>Philippines</p>
            </div>
          </div>

          <div class="d-flex align-items-start gap-3 mb-4">
            <div class="contact-icon" style="background:rgba(40,167,69,0.2); color:#28a745;">
              <i class="bi bi-telephone-fill"></i>
            </div>
            <div class="contact-info-text">
              <h6>Phone Numbers</h6>
              <p>Main: (123) 456-7890<br>Support: (123) 456-7891</p>
            </div>
          </div>

          <div class="d-flex align-items-start gap-3 mb-4">
            <div class="contact-icon" style="background:rgba(255,193,7,0.2); color:#ffc107;">
              <i class="bi bi-envelope-fill"></i>
            </div>
            <div class="contact-info-text">
              <h6>Email Address</h6>
              <p>info@smsolstudio.com<br>support@smsolstudio.com</p>
            </div>
          </div>

          <div class="d-flex align-items-start gap-3">
            <div class="contact-icon" style="background:rgba(255,26,110,0.2); color:#ff1a6e;">
              <i class="bi bi-clock-fill"></i>
            </div>
            <div class="contact-info-text">
              <h6>Business Hours</h6>
              <p>Mon - Fri: 9:00 AM - 7:00 PM<br>Saturday: 10:00 AM - 5:00 PM<br>Sunday: Closed</p>
            </div>
          </div>
        </div>

        <!-- Social -->
        <div class="glow-card p-4">
          <h5 class="font-fancy mb-4">Follow <span class="text-pink">Us</span></h5>
          <div class="d-flex justify-content-center gap-3">
            <a href="#" class="social-icon facebook"><i class="bi bi-facebook"></i></a>
            <a href="#" class="social-icon instagram"><i class="bi bi-instagram"></i></a>
            <a href="#" class="social-icon twitter"><i class="bi bi-twitter"></i></a>
            <a href="#" class="social-icon linkedin"><i class="bi bi-linkedin"></i></a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<hr class="pink-divider">

<!-- Map -->
<section class="py-5">
  <div class="container">
    <div class="map-container">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3861.1023715764693!2d121.0145094!3d14.5842123!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3397c9b2e7b1f3e5%3A0x4a5b8c5b5b5b5b5b!2sFashion%20Street%2C%20Style%20City!5e0!3m2!1sen!2sph!4v1630000000000!5m2!1sen!2sph"
        width="100%" height="380" style="border:0; display:block;" allowfullscreen loading="lazy">
      </iframe>
    </div>
  </div>
</section>

<hr class="pink-divider">

<!-- FAQ -->
<section class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="font-fancy">Frequently Asked <span class="text-pink">Questions</span></h2>
      <p style="color:#aaa;">Find answers to common questions</p>
    </div>

    <div class="col-lg-8 mx-auto">
      <div class="accordion" id="faqAccordion">

        <div class="accordion-item">
          <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
              What is your return policy?
            </button>
          </h2>
          <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
            <div class="accordion-body">We offer a 30-day return policy for unused items in original packaging. Returns are free for defective products. Contact our support team for return instructions.</div>
          </div>
        </div>

        <div class="accordion-item">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
              How long does shipping take?
            </button>
          </h2>
          <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
            <div class="accordion-body">Standard shipping takes 3-5 business days. Express shipping (1-2 business days) is available for an additional fee.</div>
          </div>
        </div>

        <div class="accordion-item">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
              Do you offer international shipping?
            </button>
          </h2>
          <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
            <div class="accordion-body">Currently, we only ship within the Philippines. We're working to expand our shipping options internationally in the future.</div>
          </div>
        </div>

        <div class="accordion-item">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
              How can I track my order?
            </button>
          </h2>
          <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
            <div class="accordion-body">Once your order ships, you'll receive a tracking number via email. You can track your order using our website or the courier's tracking system.</div>
          </div>
        </div>

        <div class="accordion-item">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
              What payment methods do you accept?
            </button>
          </h2>
          <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
            <div class="accordion-body">We accept credit/debit cards (Visa, MasterCard, American Express), PayPal, GCash, Maya, and bank transfers.</div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

{% endblock %}
